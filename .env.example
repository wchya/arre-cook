# Copy to .env on the deployment host. Never commit the populated file.
APP_ENV=production
PUBLIC_URL=https://cook.arrebyte.top
CORS_ORIGINS=https://cook.arrebyte.top

# Initial admin bootstrap. ADMIN_EMAIL should be the account you want to own
# the migrated single-user data.
ADMIN_USERNAME=admin
ADMIN_EMAIL=replace-with-admin@qq.com
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
ALLOW_REGISTER=true
EMAIL_DOMAINS=qq.com,foxmail.com

# Leave SMTP_USER/SMTP_PASSWORD empty to reuse MAIL_USERNAME/MAIL_PASSWORD from
# the blog site's .env via the two --env-file command in docs/deployment.md.
# SMTP_PASSWORD is the QQ SMTP authorization code, not mailbox password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=NiniMenu

# Garage on the blog site's Docker network. Create a dedicated bucket and key
# for this app; do not reuse the blog application's S3 key.
BLOG_DOCKER_NETWORK=web-arrebyte_default
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=cook-uploads
COOK_S3_ACCESS_KEY=replace-with-garage-access-key
COOK_S3_SECRET_KEY=replace-with-garage-secret-key
S3_PATH_STYLE=true
S3_PUBLIC_URL=/uploads/
S3_PREFIX=cook

# Optional model connection. Without a key, the built-in recommendation engine remains available.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional WeChat mini-program credentials. The AppID also belongs in
# miniprogram/project.config.json; the secret stays on the server.
WECHAT_APPID=
WECHAT_SECRET=
AGENT_RATE_LIMIT=120
