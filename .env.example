# Copy to .env on the deployment host. Never commit the populated file.
APP_ENV=production
# Go runtime soft memory budget; Python ASR / MySQL / Garage are additional.
GOMEMLIMIT=192MiB
GOMAXPROCS=2
APP_MEMORY_LIMIT=1g
APP_CPUS=2
PUBLIC_URL=https://cook.arrebyte.top
CORS_ORIGINS=https://cook.arrebyte.top
# Set TRUSTED_PROXIES to the actual reverse proxy IPs/CIDRs when customizing the network.

# Initial admin bootstrap. ADMIN_EMAIL should be the account you want to own
# the migrated single-user data.
ADMIN_USERNAME=admin
ADMIN_EMAIL=replace-with-admin@qq.com
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
ALLOW_REGISTER=true
EMAIL_DOMAINS=qq.com,foxmail.com

# NiniMenu uses a dedicated schema and account on the blog site's MySQL 8
# container. Keep this database separate from the blog's `blog` schema.
DB_DRIVER=mysql
# Set false on API replicas after the one-off DB_MIGRATE_ONLY migration.
DB_AUTO_MIGRATE=true
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ninimenu
MYSQL_USER=ninimenu
MYSQL_PASSWORD=replace-with-a-dedicated-random-password
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Leave SMTP_USER/SMTP_PASSWORD empty to reuse MAIL_USERNAME/MAIL_PASSWORD from
# the blog site's .env via the two --env-file command in docs/deployment.md.
# SMTP_PASSWORD is the QQ SMTP authorization code, not mailbox password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=arre食谱推荐小助手

# Garage on the blog site's Docker network. Create a dedicated bucket and key
# for this app; do not reuse the blog application's S3 key.
BLOG_DOCKER_NETWORK=web-arrebyte_default
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=cook-uploads
COOK_S3_ACCESS_KEY=replace-with-garage-access-key
COOK_S3_SECRET_KEY=replace-with-garage-secret-key
S3_PATH_STYLE=true
S3_PUBLIC_URL=/uploads/
S3_PREFIX=cook

# Optional model connection. Without a key, the built-in recommendation engine remains available.
# For production CPA, set CPA_CONFIG_PATH to the DSH override file. The app reads its CPA URL/key/model.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
CPA_CONFIG_PATH=
LLM_CPA_CONFIG_PATH=/run/cpa/provider-config
LLM_CPA_BASE_URL=http://host.docker.internal:8317/v1
LLM_CPA_MODEL=

# Speech-to-text: local = bundled CPU SenseVoice; remote = optional HTTPS service.
# Install the pinned local models first (see docs/video-recipes.md); no API key is needed for local.
VIDEO_ASR_PROVIDER=remote
# Optional remote service, separate from the text LLM / CPA configuration.
# Full HTTPS endpoint, e.g. https://api.openai.com/v1/audio/transcriptions.
# All three are required to enable audio fallback; subtitle import works without them.
VIDEO_ASR_URL=
VIDEO_ASR_API_KEY=
VIDEO_ASR_MODEL=

# Optional Douyin guest credentials, generated on an operator's desktop.
# Place the JSON in secrets/video/douyin-guest.json (owner UID 1000, mode 600).
# Then set /run/video-secrets/douyin-guest.json here; blank keeps anonymous HTML reads.
# No browser or yt-dlp runs on the server. See docs/video-recipes.md.
VIDEO_DOUYIN_COOKIE_FILE=

# Optional WeChat mini-program credentials. The AppID also belongs in
# miniprogram/project.config.json; the secret stays on the server.
WECHAT_APPID=
WECHAT_SECRET=
AGENT_RATE_LIMIT=120
