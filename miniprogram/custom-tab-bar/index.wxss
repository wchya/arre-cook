.tabbar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 100; padding-bottom: env(safe-area-inset-bottom); border-top: 1px solid var(--glass-border); background: var(--glass-bg); box-shadow: 0 -20rpx 60rpx rgba(26, 26, 46, .07); -webkit-backdrop-filter: blur(24px) saturate(180%); backdrop-filter: blur(24px) saturate(180%); }
.tabbar--ios { background: var(--glass-ios-bg); -webkit-backdrop-filter: var(--glass-blur-ios); backdrop-filter: var(--glass-blur-ios); }
.tabbar__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); align-items: center; height: 120rpx; padding: 0 16rpx; }

.tab { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; height: 96rpx; border-radius: 26rpx; transition: transform .18s var(--ease-spring); }
.tab--press { transform: scale(.9); }
.tab__pill { position: relative; z-index: 0; display: flex; align-items: center; justify-content: center; width: 72rpx; height: 48rpx; border-radius: 999rpx; }
/* 选中胶囊：缩放淡入，而不是瞬间出现（z-index:-1 垫在图标之下） */
.tab__pill::before { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: -1; border-radius: 999rpx; background: var(--primary-light); opacity: 0; transform: scale(.6); transition: opacity .22s ease, transform .32s var(--ease-spring); content: ""; }
.tab.is-active .tab__pill::before { opacity: 1; transform: scale(1); }
.tab__label { color: var(--text3); font-size: 20rpx; font-weight: 600; line-height: 1; transition: color .2s ease; }
.tab.is-active .tab__label { color: var(--primary); font-weight: 700; }

.tab-center { display: flex; justify-content: center; }
.ai-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 116rpx; height: 116rpx; margin-top: -56rpx; border: 8rpx solid var(--bg); border-radius: 44rpx; background: linear-gradient(135deg, #F59A6B 0%, #E8734A 52%, #D9573A 100%); box-shadow: 0 24rpx 56rpx rgba(232, 115, 74, .45), inset 0 2rpx 0 rgba(255, 255, 255, .28); transition: transform .2s var(--ease-spring), box-shadow .2s ease; }
.ai-btn--press { transform: scale(.9) rotate(-4deg); box-shadow: 0 12rpx 28rpx rgba(232, 115, 74, .38); }
.ai-btn__label { margin-top: 2rpx; color: #fff; font-size: 17rpx; font-weight: 800; line-height: 1; letter-spacing: 1rpx; }
