.profile { box-sizing: border-box; width: 100%; margin-bottom: 24rpx; padding: 28rpx; border: 1px solid var(--border); border-radius: 28rpx; background: var(--card); color: var(--text); }
.profile-head { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.profile-head-copy { flex: 1; min-width: 0; }
.profile-title { font-size: 30rpx; font-weight: 700; line-height: 1.35; }
.profile-body { min-width: 0; margin-top: 24rpx; padding-top: 24rpx; border-top: 1px solid var(--border); }
.profile-hint, .profile-feedback { color: var(--text2); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; word-break: break-word; }
.profile-head .profile-hint { margin-top: 4rpx; font-size: 22rpx; }
.profile-state { margin-top: 20rpx; }
.profile-field { min-width: 0; margin-top: 24rpx; }
.profile-label { display: block; margin-bottom: 10rpx; color: var(--text2); font-size: 24rpx; font-weight: 600; line-height: 1.45; }
.profile-select, .profile-textarea { box-sizing: border-box; width: 100%; min-width: 0; border: 1px solid var(--border); border-radius: 16rpx; background: var(--bg); color: var(--text); font-size: 28rpx; }
.profile-select { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 44px; padding: 12rpx 20rpx; line-height: 1.45; overflow-wrap: anywhere; }
.profile-select text:first-child { min-width: 0; flex: 1; }
.profile-select-arrow { flex-shrink: 0; color: var(--text2); font-size: 34rpx; }
.profile-textarea { display: block; height: 150rpx; padding: 18rpx 20rpx; line-height: 1.5; }
.profile-field + .profile-hint { margin-top: 18rpx; }
.profile-consent { box-sizing: border-box; display: flex; align-items: flex-start; gap: 12rpx; width: 100%; min-height: 88rpx; margin: 24rpx 0 18rpx; color: var(--text); font-size: 26rpx; line-height: 1.6; }
.profile-consent checkbox { flex-shrink: 0; }
.profile-consent text { min-width: 0; flex: 1; }
.profile-button { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: auto; min-width: 0; min-height: 44px; margin: 0; padding: 12rpx 22rpx; border: 1px solid var(--border); border-radius: 16rpx; background: var(--bg); color: var(--text); font-size: 26rpx; font-weight: 600; line-height: 1.35; text-align: center; white-space: normal; overflow-wrap: anywhere; word-break: break-word; }
.profile-button::after { border: 0; }
.profile-button[disabled] { opacity: .5; }
.profile-toggle { flex-shrink: 0; padding: 10rpx 18rpx; color: var(--primary); }
.profile-button--primary { border-color: var(--primary-action); background: var(--primary-action); color: var(--on-primary); }
.profile-button--full { width: 100%; }
.profile-button--quiet { margin-top: 18rpx; border-color: transparent; background: transparent; color: var(--text2); }
.profile-button--danger { border-color: var(--red); background: var(--red-light); color: var(--red); }
.profile-erase { margin-top: 20rpx; padding-top: 20rpx; border-top: 1px solid var(--border); }
.profile-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.profile-actions .profile-button { flex: 1 1 180rpx; }
.profile-feedback { margin-top: 18rpx; color: var(--text); }
.profile-feedback + .profile-button { margin-top: 16rpx; }
