.profile { margin-bottom: 24rpx; padding: 32rpx; border: 1px solid var(--border); border-radius: 28rpx; background: var(--card); color: var(--text); }
.head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx; }
.title { font-size: 30rpx; font-weight: 700; }
.hint { margin: 12rpx 0; color: var(--text2); font-size: 24rpx; line-height: 1.7; }
.body { margin-top: 24rpx; padding-top: 16rpx; border-top: 1px solid var(--border); }
button { min-height: 88rpx; margin: 8rpx 0; padding: 12rpx 20rpx; font-size: 26rpx; line-height: 1.7; color: var(--text); background: var(--bg); white-space: normal; }
.head button { color: var(--primary); font-weight: 600; }
.field-label { margin-top: 28rpx; font-size: 24rpx; font-weight: 600; color: var(--text2); }
.field { width: 100%; box-sizing: border-box; min-height: 88rpx; margin-top: 10rpx; padding: 22rpx; border-radius: 20rpx; border: 1px solid var(--border); background: var(--bg); font-size: 28rpx; line-height: 1.6; }
.text-area { height: 150rpx; }
.consent { display: flex; align-items: flex-start; gap: 12rpx; padding: 24rpx 0; font-size: 26rpx; line-height: 1.7; }
.consent checkbox { flex-shrink: 0; }
.primary { background: var(--primary); color: #fff; font-weight: 600; }
button[disabled] { opacity: .55; }
.clear { color: var(--text2); font-size: 24rpx; }
.erase { margin-top: 16rpx; padding: 16rpx; border: 1px solid var(--border); border-radius: 20rpx; }
.feedback { margin-top: 20rpx; color: var(--text); font-size: 26rpx; line-height: 1.7; overflow-wrap: anywhere; }
