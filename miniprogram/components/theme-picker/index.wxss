/* 类选择器在组件样式隔离下也生效；显式覆盖 iOS 原生按钮的默认尺寸和描边。 */
.theme-button.theme-button { box-sizing: border-box; margin: 0; font-family: inherit; line-height: 1.5; }
.theme-button.theme-button::after { display: none; border: 0; }
.theme-trigger.theme-button { display: flex; justify-content: center; align-items: center; gap: 12rpx; width: auto !important; height: auto; min-height: 44px; padding: 0 24rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--card); color: var(--primary); font-size: 24rpx; font-weight: 700; }
.theme-trigger--row.theme-button { justify-content: flex-start; width: 100% !important; padding: 28rpx 32rpx; border: 0; border-radius: 0; text-align: left; color: var(--text); font-size: 28rpx; }
.theme-trigger--row .theme-trigger__icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 12rpx; border-radius: 24rpx; background: var(--primary-light); }
.theme-trigger--row .theme-trigger__text { flex: 1; }
.theme-description { margin-top: 2rpx; color: var(--text3); font-size: 22rpx; font-weight: 400; }
.theme-body { padding: 12rpx 36rpx 28rpx; color: var(--text); }
.theme-legend { margin-bottom: 20rpx; font-size: 26rpx; font-weight: 700; }
.theme-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; }
.theme-option.theme-button { display: block; align-self: start; width: 100% !important; min-width: 0; max-width: 100%; height: auto; min-height: 0; padding: 4rpx; border: 0; border-radius: 20rpx; background: transparent; color: var(--text); }
.theme-option.is-selected { color: var(--primary); }
.theme-preview { position: relative; box-sizing: border-box; width: 100%; height: 136rpx; padding: 18rpx 12rpx; overflow: hidden; border-radius: 20rpx; }
.theme-option.is-selected .theme-preview { box-shadow: inset 0 0 0 2rpx var(--primary); }
.theme-preview__card { box-sizing: border-box; height: 100%; padding: 14rpx; border-radius: 14rpx; }
.theme-check { position: absolute; top: 8rpx; right: 8rpx; display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; border-radius: 50%; background: var(--primary-action); }
.theme-preview__ticket { height: 42rpx; margin-bottom: 12rpx; border-radius: 6rpx; }
.theme-preview__action { height: 14rpx; border-radius: 99rpx; }
.theme-name { margin-top: 10rpx; font-size: 22rpx; font-weight: 600; white-space: nowrap; }
.theme-legend--mode { margin-top: 36rpx; }
.theme-modes { display: flex; gap: 8rpx; padding: 8rpx; border-radius: 999rpx; background: var(--inset); }
.theme-mode.theme-button { flex: 1 1 0%; width: 0 !important; min-width: 0; height: auto; min-height: 44px; padding: 12rpx 4rpx; display: flex; align-items: center; justify-content: center; border: 0; background: transparent; border-radius: 999rpx; color: var(--text2); font-size: 24rpx; }
.theme-mode.is-selected { background: var(--card); color: var(--primary); font-weight: 700; }
.theme-storage { margin: 30rpx 0; color: var(--text3); font-size: 22rpx; text-align: center; line-height: 1.8; }
.theme-done.theme-button { display: flex; align-items: center; justify-content: center; width: 100% !important; height: auto; min-height: 48px; padding: 16rpx 24rpx; border: 0; border-radius: 999rpx; background: var(--primary-action); color: var(--on-primary); font-size: 30rpx; font-weight: 700; }
.theme-press { opacity: .8; }
