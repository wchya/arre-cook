<view class="draft">
  <view class="draft-head"><text>用一句话记餐</text><button disabled="{{saving}}" bindtap="toggle">{{open ? '收起' : '打开文字记餐'}}</button></view>
  <view wx:if="{{open}}" class="draft-body">
    <view class="hint">仅把这段描述发送给已配置的 AI 整理，不读取健康档案。草稿需核对后保存，份量未知可留空，不自动计算营养。</view>
    <view wx:if="{{status}}" class="hint">{{status.enabled ? '今日可整理 ' + status.quota.remaining + '/' + status.quota.limit + ' 次；请求发起后计次，失败也可能消耗额度。' : '文字整理尚未启用，可继续手动记餐。'}}</view>
    <view wx:else class="hint">正在读取服务状态；读取失败可重试。<button bindtap="loadStatus">重试状态</button></view>
    <view class="label">描述自己实际吃过的一餐</view>
    <textarea value="{{text}}" maxlength="1000" disabled="{{busy || submitted}}" placeholder="例如：中午我吃了番茄鸡蛋和半碗米饭" bindinput="onText" />
    <view class="actions"><button disabled="{{busy || submitted || !text || !status.enabled || !status.quota.remaining}}" bindtap="parse">{{busy ? '正在整理…' : '整理成草稿'}}</button><button wx:if="{{busy}}" bindtap="cancel">停止整理</button></view>
    <block wx:if="{{items.length}}">
      <view class="label">待核对 · {{items.length}} 个食物项，尚未保存</view>
      <view class="columns"><view><view class="label">实际日期</view><picker mode="date" value="{{date}}" end="{{today}}" disabled="{{submitted}}" bindchange="onDate"><view class="field">{{date}}</view></picker></view><view><view class="label">实际餐次</view><picker range="{{mealLabels}}" value="{{mealIndex}}" disabled="{{submitted}}" bindchange="onMeal"><view class="field">{{mealLabels[mealIndex]}}</view></picker></view></view>
      <view wx:for="{{items}}" wx:key="index" class="item">
        <view class="hint">原文：{{item.evidence}}</view>
        <view class="label">食物 {{index + 1}}</view><input value="{{item.dish_name}}" maxlength="100" disabled="{{submitted}}" data-index="{{index}}" data-field="dish_name" bindinput="onItem" />
        <view class="label">本人吃下的份量（可留空）</view><input value="{{item.portion}}" maxlength="100" disabled="{{submitted}}" data-index="{{index}}" data-field="portion" bindinput="onItem" />
        <button disabled="{{submitted}}" data-index="{{index}}" bindtap="removeItem">移除食物 {{index + 1}}</button>
      </view>
      <checkbox-group bindchange="onConsent"><label class="consent"><checkbox value="confirmed" checked="{{confirmed}}" disabled="{{submitted}}" />已核对同一次实际食用、日期和餐次；份量属于我本人，已移除未吃或重复项目。</label></checkbox-group>
      <button disabled="{{saving || !confirmed || !mealIndex || !date}}" bindtap="save">{{saving ? '正在保存…' : submitted ? '重试确认保存' : '确认保存这餐'}}</button>
      <view wx:if="{{submitted}}" class="hint">正在核对这次提交的保存结果，暂时保留同一份内容供重试。</view>
    </block>
    <view wx:if="{{message}}" class="message">{{message}}</view>
  </view>
</view>
