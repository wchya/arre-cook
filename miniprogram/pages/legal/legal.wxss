.legal-doc { padding: 40rpx 36rpx; }
.legal-sec + .legal-sec { margin-top: 36rpx; padding-top: 36rpx; border-top: 1px solid var(--border); }
.legal-sec__h { margin-bottom: 16rpx; color: var(--text); font-size: 30rpx; font-weight: 700; }
.legal-sec__p { color: var(--text2); font-size: 27rpx; line-height: 1.9; text-align: justify; }
.legal-sec__p + .legal-sec__p { margin-top: 14rpx; }
.legal-foot { margin: 36rpx 16rpx 0; color: var(--text4); font-size: 22rpx; line-height: 1.7; text-align: center; }
