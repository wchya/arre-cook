page { height: 100%; overflow: hidden; background: var(--bg); }

.nav-bell { position: relative; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border: 1px solid var(--border); border-radius: 50%; background: rgba(255, 255, 255, .92); box-shadow: 0 2rpx 6rpx rgba(26, 26, 46, .05), 0 12rpx 36rpx rgba(26, 26, 46, .06); }
.nav-bell__dot { position: absolute; top: -6rpx; right: -8rpx; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border: 3rpx solid var(--bg); border-radius: 999rpx; background: var(--red); color: #fff; font-size: 18rpx; font-weight: 700; line-height: 26rpx; text-align: center; }

.hello { margin-bottom: 40rpx; }
.hello__greet { margin-bottom: 6rpx; color: var(--text2); font-size: 28rpx; }
.hello__title { color: var(--text); font-size: 52rpx; font-weight: 800; line-height: 1.25; letter-spacing: -1rpx; }

/* 午晚餐入口 */
.meal-entries { margin-bottom: 48rpx; }
.meal-entry { position: relative; min-height: 200rpx; padding: 36rpx; overflow: hidden; border: 3rpx solid transparent; border-radius: 32rpx; transition: transform .15s ease, border-color .2s ease; }
.meal-entry--lunch { border-color: rgba(232, 115, 74, .12); background: var(--primary-light); }
.meal-entry--dinner { border-color: rgba(110, 198, 184, .12); background: var(--mint-light); }
.meal-entry--lunch.is-active { border-color: var(--primary); }
.meal-entry--dinner.is-active { border-color: var(--mint); }
.meal-entry.is-busy { opacity: .7; }
.meal-entry__emoji { display: block; margin-bottom: 14rpx; font-size: 56rpx; line-height: 1; }
.meal-entry__title { margin-bottom: 4rpx; color: var(--text); font-size: 30rpx; font-weight: 700; }
.meal-entry__desc { color: var(--text2); font-size: 24rpx; }

/* 今日推荐 */
.rec-head { scroll-margin-top: 24rpx; }
.rec-change { margin-left: 8rpx; }
.rec-card { overflow: hidden; transition: transform .15s ease; }
.rec-card--press { transform: scale(.985); }
.rec-card__media { position: relative; height: 400rpx; }
.rec-card__badge { position: absolute; top: 24rpx; left: 24rpx; z-index: 1; padding: 6rpx 24rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .92); color: var(--primary); font-size: 24rpx; font-weight: 600; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
.rec-card__meals { position: absolute; top: 24rpx; right: 24rpx; z-index: 1; display: flex; gap: 12rpx; }
.meal-tag { padding: 2rpx 20rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .9); color: var(--primary); font-size: 20rpx; font-weight: 600; }
.meal-tag--mint { color: var(--mint-ink); }
.meal-tag--lunch { background: var(--primary); color: #fff; }
.meal-tag--dinner { background: var(--mint); color: #fff; }
.rec-card__name { margin-bottom: 12rpx; color: var(--text); font-size: 40rpx; font-weight: 700; line-height: 1.35; }
.rec-card__reasons { margin-top: 20rpx; gap: 12rpx; }
.rec-card__actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.rec-sk-img { height: 400rpx; border-radius: 0; }
.rec-sk-line { width: 55%; height: 40rpx; margin-bottom: 20rpx; }
.rec-sk-line.short { width: 80%; height: 32rpx; border-radius: 999rpx; }
.rec-progress { margin-top: 16rpx; color: var(--text3); font-size: 22rpx; text-align: center; }
.rec-quote { margin-top: 16rpx; padding: 0 32rpx; color: var(--text2); font-size: 26rpx; font-style: italic; line-height: 1.7; text-align: center; }
.rec-gap { height: 48rpx; }

/* 入口卡片 */
.entry { display: flex; align-items: center; gap: 28rpx; margin-bottom: 48rpx; padding: 32rpx; transition: transform .15s ease; }
.entry--ai { border-color: rgba(232, 115, 74, .15); }
.entry__icon { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 20rpx; font-size: 48rpx; }
.entry__icon--ai { background: linear-gradient(135deg, var(--purple-light), var(--primary-light)); }
.entry__icon--moon { background: linear-gradient(135deg, var(--yellow-light), var(--primary-light)); }
.entry__title { margin-bottom: 4rpx; color: var(--text); font-size: 30rpx; font-weight: 700; }
.entry__desc { color: var(--text2); font-size: 24rpx; }
.more-label { margin-bottom: 32rpx; }

/* 心情 */
.moods { margin: 0 -40rpx 40rpx; padding: 0 40rpx 8rpx; white-space: nowrap; }
.mood { display: inline-flex; flex-direction: column; align-items: center; min-width: 160rpx; margin-right: 20rpx; padding: 24rpx 32rpx; border: 4rpx solid var(--border); border-radius: 32rpx; background: var(--card); transition: border-color .2s ease, background-color .2s ease; }
.mood.is-active { border-color: var(--primary); background: var(--primary-light); }
.mood__emoji { margin-bottom: 8rpx; font-size: 56rpx; line-height: 1; }
.mood__label { color: var(--text2); font-size: 22rpx; font-weight: 500; }
.mood.is-active .mood__label { color: var(--primary); }
.mood-title { margin-bottom: 24rpx; color: var(--text); font-size: 32rpx; font-weight: 700; }
.mood-sk { height: 340rpx; border-radius: 32rpx; }

/* 转盘 */
.wheel-wrap { position: relative; width: 460rpx; height: 460rpx; margin: 16rpx auto 0; }
.wheel-pointer { position: absolute; top: -20rpx; left: 50%; z-index: 3; width: 0; height: 0; border-top: 40rpx solid var(--primary); border-right: 24rpx solid transparent; border-left: 24rpx solid transparent; filter: drop-shadow(0 4rpx 6rpx rgba(232, 115, 74, .3)); transform: translateX(-50%); }
.wheel { position: relative; width: 460rpx; height: 460rpx; overflow: hidden; border: 8rpx solid var(--primary); border-radius: 50%; background-color: var(--primary-light); box-shadow: 0 8rpx 48rpx rgba(232, 115, 74, .2); transition: transform 3.2s cubic-bezier(.12, .72, .12, 1); }
.wheel__label { position: absolute; top: 50%; left: 50%; width: 222rpx; height: 40rpx; margin-top: -20rpx; transform-origin: 0 50%; }
.wheel__text { position: absolute; top: 0; left: 50rpx; width: 150rpx; color: #fff; font-size: 22rpx; font-weight: 700; line-height: 40rpx; text-align: center; white-space: nowrap; }
.wheel-hub { position: absolute; top: 50%; left: 50%; z-index: 2; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin: -56rpx 0 0 -56rpx; border-radius: 50%; background: var(--card); box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .12); color: var(--primary); font-size: 30rpx; font-weight: 800; }
.wheel-hub.is-spinning { opacity: .75; }

/* 盲盒（3D 翻转） */
.blind { height: 440rpx; perspective: 1600rpx; }
.blind__inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .6s cubic-bezier(.4, .1, .2, 1); }
.blind__inner.is-flipped { transform: rotateY(180deg); }
.blind__face { position: absolute; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; border: 3rpx solid var(--border2); -webkit-backface-visibility: hidden; backface-visibility: hidden; }
.blind__front { display: flex; flex-direction: column; align-items: center; justify-content: center; }
.blind__shine { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(120deg, transparent 30%, rgba(240, 230, 255, .55) 50%, transparent 70%); background-size: 300% 300%; animation: shimmer 3s infinite linear; }
.blind__gift { margin-bottom: 16rpx; font-size: 80rpx; line-height: 1; }
.blind__title { margin-bottom: 4rpx; color: var(--text); font-size: 32rpx; font-weight: 700; }
.blind__tip { color: var(--text3); font-size: 24rpx; font-style: italic; }
.blind__back { display: flex; flex-direction: column; transform: rotateY(180deg); }
.blind__media { flex: 1; min-height: 0; }
.blind__body { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; }
.blind__name { color: var(--text); font-size: 30rpx; font-weight: 700; }
.blind__meta { margin-top: 2rpx; color: var(--text2); font-size: 22rpx; }
.blind__hint { margin-top: 4rpx; color: var(--purple); font-size: 22rpx; }
.blind__actions { display: flex; flex-direction: column; gap: 12rpx; flex-shrink: 0; }
