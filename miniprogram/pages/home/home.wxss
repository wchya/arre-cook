.mp-screen { height: 100vh; }
.home-content { padding-top: 24rpx; }
.home-brand { display: flex; align-items: center; color: #26342b; font-family: Georgia, serif; font-size: 24rpx; font-weight: 700; }
.home-mark { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; margin-right: 10rpx; border-radius: 11rpx; background: #1f2924; color: #f5d8a4; font-size: 21rpx; }
.home-privacy { margin-left: auto; padding: 8rpx 13rpx; border: 1px solid #dce4dd; border-radius: 99rpx; color: #4f755d; font-family: sans-serif; font-size: 18rpx; font-weight: 500; }
.home-greeting { margin-top: 42rpx; color: #1f2924; font-family: Georgia, "Songti SC", serif; font-size: 39rpx; font-weight: 800; line-height: 1.25; }
.home-date { margin-top: 10rpx; color: #68756c; font-size: 20rpx; }
.home-error { margin-top: 20rpx; }
.mp-section { margin-top: 35rpx; }
.mp-section-heading { align-items: center; }
.refresh-button { height: 56rpx; padding: 0 17rpx; border: 1px solid #d6ded7; border-radius: 8rpx; background: #fffefa; color: #356748; font-size: 19rpx; line-height: 56rpx; }
.recommend-list { border-top: 1px solid #dedfd9; }
.recommend-item { display: flex; min-height: 208rpx; padding: 18rpx 0; border-bottom: 1px solid #dedfd9; }
.dish-image { width: 190rpx; height: 190rpx; flex: 0 0 190rpx; border-radius: 11rpx; background: #e6e8e0; }
.dish-placeholder { display: flex; align-items: center; justify-content: center; color: #777f76; font-size: 40rpx; }
.dish-info { min-width: 0; flex: 1; padding-left: 18rpx; }
.dish-name { overflow: hidden; color: #243128; font-size: 25rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.dish-meta { margin-top: 7rpx; color: #68756c; font-size: 18rpx; }
.dish-reason { display: -webkit-box; overflow: hidden; margin-top: 9rpx; color: #52695a; font-size: 18rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.record-button { height: 54rpx; padding: 0 15rpx; margin-top: 12rpx; border-radius: 7rpx; background: #1f2924; color: #fff; font-size: 18rpx; line-height: 54rpx; }
.record-button[disabled] { opacity: .5; }
.text-link { color: #326c4c; font-size: 20rpx; font-weight: 700; }
.empty-panel { color: #626f66; font-size: 21rpx; line-height: 1.6; }
.empty-record { padding: 6rpx 0; color: #68756c; font-size: 20rpx; line-height: 1.6; }
.today-row { display: flex; align-items: center; justify-content: space-between; padding: 13rpx 0; border-bottom: 1px solid #e7e9e3; }
.today-row:last-child { border-bottom: 0; }
.today-dish { color: #27352c; font-size: 22rpx; font-weight: 700; }
.record-check { color: #34744f; font-size: 18rpx; }
.home-foot { padding: 30rpx 4rpx 12rpx; color: #717d74; font-size: 17rpx; line-height: 1.5; }
.loading-block { padding: 25rpx; border: 1px solid #e1e3dc; border-radius: 14rpx; background: #fffefa; }
.loading-line { width: 70%; height: 20rpx; margin: 8rpx 0; border-radius: 99rpx; background: #e9ebe5; }
.loading-line.short { width: 45%; }
