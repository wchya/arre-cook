<page-meta page-style="{{appearanceStyle}}" />
<view class="screen">
  <nav-bar icon="house" title="arre食谱推荐小助手" subtitle="今天也好好吃饭" theme="plain">
    <view class="nav-bell" hover-class="tap-active" bindtap="goNotifications" aria-role="button" aria-label="站内信">
      <icon name="bell" size="34" stroke="2.3" color="text2" />
      <view wx:if="{{unread}}" class="nav-bell__dot">{{unread > 99 ? '99+' : unread}}</view>
    </view>
  </nav-bar>

  <scroll-view
    class="screen-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-with-animation
    scroll-into-view="{{recScrollId}}"
    refresher-enabled
    refresher-background="{{refresherBg}}"
    refresher-default-style="{{refresherStyle}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="content anim-fade-up">
      <view class="hello">
        <view class="hello__top"><view class="hello__greet">{{greeting}}</view><theme-picker /></view>
        <view class="hello__title">今天<text class="accent">想吃什么</text>？</view>
      </view>

      <view wx:if="{{error}}" class="notice notice-error mb-24"><icon name="circle-alert" size="30" color="red" /><text class="flex-1">{{error}}</text></view>

      <view class="card card-pad mb-24 health-summary">
        <view class="section-title">这一周，吃得有记录</view>
        <view wx:if="{{healthSummaryError}}"><view class="hint">周报摘要暂时无法读取</view><button class="btn btn-ghost" bindtap="loadHealthSummary">重试</button></view>
        <view wx:elif="{{healthSummaryLoading}}" class="hint">正在整理最近七天的记录…</view>
        <block wx:elif="{{healthSummary}}">
          <view class="hint">{{healthSummary.from}} — {{healthSummary.to}} · 北京时间</view>
          <view class="health-summary__counts">{{healthSummary.logged_days}} 天有实际饮食记录 · {{healthSummary.complete_days}} 天确认完整</view>
          <view class="hint">{{healthSummary.meal_event_count}} 餐 · {{healthSummary.item_count}} 个食物项<text wx:if="{{healthSummary.not_eaten_meals}}"> · {{healthSummary.not_eaten_meals}} 餐明确未吃</text></view>
          <view class="hint">{{healthSummary.headline}}。未记录不代表没有吃。</view>
        </block>
        <button class="btn btn-ghost health-summary__link" bindtap="goHealthReport">查看周报 →</button>
      </view>

      <!-- 午 / 晚餐入口 -->
      <view class="grid-2 meal-entries">
        <view class="meal-entry meal-entry--lunch {{recMeal === 'lunch' ? 'is-active' : ''}} {{pickingMeal ? 'is-busy' : ''}}" hover-class="tap-active" hover-stay-time="80" data-meal="lunch" bindtap="pickMeal">
          <text class="meal-entry__emoji">🍳</text>
          <view class="meal-entry__title">中午吃点好的</view>
          <view class="meal-entry__desc">{{pickingMeal === 'lunch' ? '推荐中…' : '午餐推荐 →'}}</view>
        </view>
        <view class="meal-entry meal-entry--dinner {{recMeal === 'dinner' ? 'is-active' : ''}} {{pickingMeal ? 'is-busy' : ''}}" hover-class="tap-active" hover-stay-time="80" data-meal="dinner" bindtap="pickMeal">
          <text class="meal-entry__emoji">🍲</text>
          <view class="meal-entry__title">晚上吃点温暖的</view>
          <view class="meal-entry__desc">{{pickingMeal === 'dinner' ? '推荐中…' : '晚餐推荐 →'}}</view>
        </view>
      </view>

      <!-- 今日推荐 -->
      <view id="rec-anchor" class="section-head rec-head">
        <view class="section-title">✨ 今日推荐</view>
        <view class="section-action {{changing ? 'tap-fade' : ''}}" hover-class="tap-active" bindtap="changeRecommend">
          <icon name="refresh-cw" size="26" stroke="2.4" color="text2" />
          <text class="rec-change">{{changing ? '挑选中…' : '换一个'}}</text>
        </view>
      </view>

      <view wx:if="{{loadingRec && !current}}" class="card rec-card">
        <view class="skeleton rec-sk-img"></view>
        <view class="card-pad"><view class="skeleton rec-sk-line"></view><view class="skeleton rec-sk-line short"></view></view>
      </view>

      <view wx:elif="{{current}}" class="card rec-card anim-pop-soft" hover-class="rec-card--press" hover-stay-time="80" bindtap="openCurrent">
        <view wx:if="{{current.cover}}" class="rec-card__media">
          <dish-image src="{{current.cover}}" emoji="{{current.emoji}}" emoji-size="128" lazy="{{false}}" />
          <view class="rec-card__badge">{{isSmart ? '🧠 按你的口味' : '🔥 推荐'}}</view>
          <view class="rec-card__meals">
            <text class="meal-tag {{recMeal === 'lunch' ? 'meal-tag--lunch' : ''}}">🍳 午餐</text>
            <text class="meal-tag meal-tag--mint {{recMeal === 'dinner' ? 'meal-tag--dinner' : ''}}">🍲 晚餐</text>
          </view>
        </view>
        <view class="recipe-ticket">
          <view class="recipe-ticket__eyebrow">{{isSmart ? '按你的口味 · 今日推荐' : '今天好好吃饭'}}</view>
          <view class="rec-card__name">{{current.name}}</view>
          <view class="chips">
            <text class="chip chip-primary">{{current.category}}</text>
            <text wx:if="{{current.cookTime}}" class="chip chip-mint">{{current.cookTime}}分钟</text>
            <text class="chip chip-primary">{{current.diffLabel}}</text>
            <text wx:if="{{current.taste}}" class="chip chip-pink">{{current.taste}}</text>
          </view>
          <view wx:if="{{currentReasons.length}}" class="chips rec-card__reasons">
            <text wx:for="{{currentReasons}}" wx:key="*this" class="chip chip-sm chip-yellow">💡 {{item}}</text>
          </view>
          <view class="rec-card__actions">
            <view class="btn flex-1 btn-primary" hover-class="tap-active" hover-stop-propagation data-meal="lunch" catchtap="recordCurrent">
              <view wx:if="{{recordingMeal === 'lunch'}}" class="spinner"></view><text wx:else>🍳 中午吃这个</text>
            </view>
            <view class="btn flex-1 btn-mint" hover-class="tap-active" hover-stop-propagation data-meal="dinner" catchtap="recordCurrent">
              <view wx:if="{{recordingMeal === 'dinner'}}" class="spinner"></view><text wx:else>🍲 晚上吃这个</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:elif="{{!loadingRec}}" class="card">
        <empty emoji="🍽" title="暂时没有推荐" desc="下拉刷新，或者去菜谱里挑一道" compact />
      </view>

      <view wx:if="{{isSmart && recItems.length > 1}}" class="rec-progress">第 {{recIndex + 1}} / {{recItems.length}} 道 · 换一个会从下一道开始</view>
      <view wx:if="{{recQuote}}" class="rec-quote">“{{recQuote}}”</view>
      <view class="rec-gap"></view>

      <!-- AI 推荐官 -->
      <view class="card entry entry--ai" hover-class="tap-active" hover-stay-time="80" bindtap="goAssistant">
        <view class="entry__icon entry__icon--ai"><icon name="sparkles" size="46" stroke="2.4" color="primary" /></view>
        <view class="flex-1">
          <view class="entry__title">🤖 AI 推荐官</view>
          <view class="entry__desc truncate">{{profileSummary || '根据你的口味画像推荐，还能聊着点菜'}}</view>
        </view>
        <icon name="chevron-right" size="30" stroke="2.4" color="text3" />
      </view>

      <view class="divider-label more-label">更多玩法</view>

      <!-- 心情 -->
      <view class="section-head"><view class="section-title">😃 今天的心情</view></view>
      <scroll-view class="moods" scroll-x enhanced show-scrollbar="{{false}}">
        <view wx:for="{{moods}}" wx:key="key" class="mood {{mood === item.key ? 'is-active' : ''}}" hover-class="tap-active" hover-stay-time="60" data-mood="{{item.key}}" bindtap="chooseMood">
          <text class="mood__emoji">{{item.emoji}}</text>
          <text class="mood__label">{{item.label}}</text>
        </view>
      </scroll-view>

      <view wx:if="{{moodDishes.length}}" class="section">
        <view class="mood-title">心情推荐</view>
        <view class="grid-2">
          <dish-card wx:for="{{moodDishes}}" wx:key="id" dish="{{item}}" />
        </view>
      </view>
      <view wx:elif="{{moodLoading}}" class="grid-2 section">
        <view class="skeleton mood-sk"></view><view class="skeleton mood-sk"></view>
      </view>

      <!-- 转一转 -->
      <view wx:if="{{wheelLabels.length}}" class="section">
        <view class="section-head"><view class="section-title">🎰 转一转</view><text class="t-xs c-text3">转到哪道吃哪道</text></view>
        <view class="wheel-wrap">
          <view class="wheel-pointer"></view>
          <view class="wheel {{spinning ? 'is-spinning' : ''}}" style="background:{{wheelBg}};transform:rotate({{wheelDeg}}deg);">
            <view wx:for="{{wheelLabels}}" wx:key="id" class="wheel__label" style="transform:rotate({{item.angle}}deg);">
              <text class="wheel__text" style="color:{{item.color}};">{{item.name}}</text>
            </view>
          </view>
          <view class="wheel-hub {{spinning ? 'is-spinning' : ''}}" hover-class="tap-active" bindtap="spinWheel" aria-role="button" aria-label="转动转盘">{{spinning ? '🎰' : '转'}}</view>
        </view>
      </view>

      <!-- 明天吃什么 -->
      <view class="card entry" hover-class="tap-active" hover-stay-time="80" bindtap="goTomorrow">
        <view class="entry__icon entry__icon--moon">🌙</view>
        <view class="flex-1">
          <view class="entry__title">🌙 明天吃什么？</view>
          <view class="entry__desc">提前规划明天的菜单，不用再临时纠结</view>
        </view>
        <icon name="chevron-right" size="30" stroke="2.4" color="text3" />
      </view>
    </view>
    <view class="tabbar-spacer"></view>
  </scroll-view>
</view>

<confetti id="confetti" />
