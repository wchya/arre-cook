/* 无家庭引导 */
.join-hero { text-align: center; }
.join-hero__icon { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin: 0 auto; border-radius: 32rpx; background: var(--primary-light); }
.join-hero__title { margin-top: 24rpx; color: var(--text); font-size: 36rpx; font-weight: 800; }
.join-hero__desc { margin-top: 12rpx; color: var(--text2); font-size: 26rpx; line-height: 1.7; }
.join-textarea { box-sizing: border-box; width: 100%; min-height: 128rpx; margin-top: 12rpx; padding: 24rpx 28rpx; border: 3rpx solid var(--border); border-radius: 24rpx; background: var(--bg); color: var(--text); font-size: 28rpx; line-height: 1.6; transition: border-color .2s ease, background-color .2s ease; }
.join-textarea.is-focus { border-color: var(--primary); background: var(--card); }

/* 家庭头部 */
.fam-hero { position: relative; overflow: hidden; padding: 36rpx 32rpx; background: linear-gradient(135deg, var(--primary), #F2915F); }
.fam-hero__glow { position: absolute; top: -80rpx; right: -60rpx; width: 260rpx; height: 260rpx; border-radius: 50%; background: rgba(255, 255, 255, .18); }
.fam-hero__row { position: relative; display: flex; align-items: center; gap: 24rpx; }
.fam-hero__icon { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 28rpx; background: rgba(255, 255, 255, .22); }
.fam-hero__name { color: #fff; font-size: 38rpx; font-weight: 800; }
.fam-hero__meta { margin-top: 6rpx; color: rgba(255, 255, 255, .85); font-size: 24rpx; }
.fam-hero__edit { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; flex-shrink: 0; border-radius: 20rpx; background: rgba(255, 255, 255, .18); }

/* 成员 */
.member-avatar { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; flex-shrink: 0; border-radius: 24rpx; background: var(--mint-light); color: var(--mint-ink); font-size: 32rpx; font-weight: 800; }
.member-avatar--owner { background: var(--primary-light); color: var(--primary); }
.member-name { display: flex; align-items: center; gap: 12rpx; }
.owner-chip { gap: 4rpx; }
.member-remove { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; flex-shrink: 0; border-radius: 18rpx; }

/* 邀请 */
.invite-row { display: flex; align-items: center; gap: 16rpx; }
.icon-btn { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 28rpx; background: var(--primary); }
.icon-btn.is-disabled { opacity: .45; }
.invite-link { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; padding: 18rpx 24rpx; border-radius: 20rpx; background: var(--primary-light); color: var(--primary); font-size: 24rpx; }
.invite-link text { flex: 1; min-width: 0; }
.invite-link__copy { flex: none; font-weight: 700; }
.invite-item { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; }
.invite-item + .invite-item { border-top: 1px solid var(--border); }
.invite-item__email { color: var(--text); font-size: 26rpx; }
.invite-item__exp { margin-top: 2rpx; color: var(--text3); font-size: 22rpx; }
.invite-item__revoke { flex-shrink: 0; padding: 8rpx 22rpx; border-radius: 999rpx; background: var(--bg); color: var(--red); font-size: 24rpx; font-weight: 600; }

/* 买菜清单 */
.shop-add { display: flex; align-items: center; gap: 16rpx; }
.shop-amount { width: 160rpx; flex-shrink: 0; }
.shop-empty { padding: 48rpx 0; text-align: center; color: var(--text3); font-size: 26rpx; }
.shop-list { margin-top: 16rpx; }
.shop-item { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; }
.shop-item + .shop-item { border-top: 1px solid var(--border); }
.shop-check { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; flex-shrink: 0; border: 3rpx solid var(--border2); border-radius: 12rpx; background: var(--card); transition: background-color .18s ease, border-color .18s ease; }
.shop-check.is-on { border-color: var(--mint); background: var(--mint); }
.shop-name { display: flex; flex: 1; min-width: 0; align-items: baseline; gap: 12rpx; color: var(--text); font-size: 28rpx; }
.shop-name.is-done { color: var(--text3); text-decoration: line-through; }
.shop-amount-text { flex-shrink: 0; color: var(--text3); font-size: 24rpx; }
.shop-del { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; flex-shrink: 0; }
.shop-foot { margin-top: 16rpx; text-align: right; color: var(--text3); font-size: 22rpx; }

/* 转让 / 导入弹层 */
.transfer-item { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 8rpx; border-radius: 20rpx; }
.transfer-item + .transfer-item { border-top: 1px solid var(--border); }
.import-add { flex-shrink: 0; color: var(--primary); font-size: 26rpx; font-weight: 700; }

/* 危险区图标底色 */
.tone-danger { background: rgba(220, 38, 38, .10); color: var(--red); }

/* 菜谱删除申请 */
.req { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 32rpx; }
.req + .req { border-top: 1px solid var(--border); }
.req__cover { width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 20rpx; background: var(--bg); }
.req__cover--ph { display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.req__main { flex: 1; min-width: 0; }
.req__name { color: var(--text); font-size: 28rpx; font-weight: 700; }
.req__meta { margin-top: 6rpx; color: var(--text3); font-size: 22rpx; }
.req__actions { display: flex; flex-shrink: 0; gap: 12rpx; }
.req__btn { flex-shrink: 0; padding: 10rpx 22rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; }
.req__btn--approve { background: var(--primary); color: #fff; }
.req__btn--reject, .req__btn--cancel { border: 1px solid var(--border); background: var(--bg); color: var(--text2); }

.sheet-body { padding: 8rpx 4rpx 16rpx; }
