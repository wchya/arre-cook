.sk { height: 320rpx; border-radius: 32rpx; margin-bottom: 24rpx; }
.view-seg { margin-bottom: 28rpx; }
.section-title { display: flex; align-items: center; gap: 14rpx; }

/* 饮食日记 */
.day { margin-bottom: 28rpx; }
.day__head { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 12rpx; padding-left: 8rpx; }
.day__label { color: var(--text); font-size: 26rpx; font-weight: 700; }
.day__weekday { color: var(--text3); font-size: 22rpx; }
.day__card { padding: 8rpx 0; }
.entry { display: flex; align-items: flex-start; gap: 18rpx; padding: 22rpx 32rpx; }
.entry + .entry { border-top: 1px solid var(--border); }
.entry__meal { flex-shrink: 0; width: 56rpx; font-size: 44rpx; line-height: 1.1; text-align: center; }
.entry__tag { color: var(--text3); font-size: 22rpx; font-weight: 600; }
.entry__name { margin-top: 4rpx; color: var(--text); font-size: 30rpx; font-weight: 600; }
.entry__chips { margin-top: 12rpx; }
.entry__notes { margin-top: 10rpx; color: var(--text3); font-size: 24rpx; line-height: 1.6; }
.entry__del { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 16rpx; }
.row-link { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; padding: 28rpx 32rpx; border: 1px solid var(--border); border-radius: 28rpx; background: var(--card); box-shadow: var(--shadow-card); color: var(--text2); font-size: 26rpx; font-weight: 600; }

/* 健康报告 */
.period { display: inline-flex; gap: 8rpx; margin-bottom: 24rpx; padding: 8rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--bg); }
.period__btn { padding: 12rpx 34rpx; border-radius: 999rpx; color: var(--text3); font-size: 24rpx; font-weight: 700; }
.period__btn.is-active { background: var(--card); color: var(--text); box-shadow: 0 2rpx 8rpx rgba(26, 26, 46, .08); }
.stat-unit { margin-left: 8rpx; color: var(--text3); font-size: 22rpx; font-weight: 600; }
.insight { position: relative; margin-bottom: 16rpx; padding-left: 24rpx; color: var(--text2); font-size: 26rpx; line-height: 1.7; }
.insight:last-child { margin-bottom: 0; }
.insight::before { position: absolute; top: 10rpx; bottom: 10rpx; left: 0; width: 6rpx; border-radius: 999rpx; background: var(--mint); content: ""; }

.bar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; font-size: 24rpx; }
.bar:last-child { margin-bottom: 0; }
.bar__label { width: 132rpx; flex-shrink: 0; color: var(--text2); font-weight: 500; }
.bar__track { flex: 1; height: 16rpx; overflow: hidden; border-radius: 999rpx; background: var(--bg); }
.bar__fill { height: 100%; border-radius: 999rpx; background: var(--primary); transition: width .5s cubic-bezier(.2, .8, .2, 1); }
.bar__fill--mint { background: var(--mint); }
.bar__fill--pink { background: var(--pink); }
.bar__fill--primary { background: var(--primary); }
.bar__fill--yellow { background: var(--yellow); }
.bar__fill--purple { background: var(--purple); }
.bar__val { width: 84rpx; flex-shrink: 0; color: var(--text3); text-align: right; font-variant-numeric: tabular-nums; }
.hint { margin-top: 16rpx; color: var(--text3); font-size: 22rpx; line-height: 1.6; }

.action { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.action:last-child { margin-bottom: 0; }
.action__idx { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--primary-light); color: var(--primary); font-size: 22rpx; font-weight: 700; }
.action__text { flex: 1; padding-top: 2rpx; color: var(--text2); font-size: 26rpx; line-height: 1.6; }

.rec-head { display: flex; align-items: center; gap: 14rpx; padding: 28rpx 32rpx 20rpx; border-bottom: 1px solid var(--border); color: var(--text); font-size: 32rpx; font-weight: 700; }
.rec { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 32rpx; }
.rec + .rec { border-top: 1px solid var(--border); }
.rec__thumb { width: 96rpx; height: 96rpx; flex-shrink: 0; overflow: hidden; border-radius: 20rpx; }
.rec__name { color: var(--text); font-size: 28rpx; font-weight: 600; }
.rec__reason { margin-top: 4rpx; color: var(--text3); font-size: 22rpx; line-height: 1.6; }
.disclaimer { margin-top: 24rpx; color: var(--text3); font-size: 22rpx; line-height: 1.7; text-align: center; }

/* 悬浮按钮 */
.fab { position: fixed; right: 36rpx; bottom: calc(56rpx + env(safe-area-inset-bottom)); z-index: 200; display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--primary); box-shadow: 0 12rpx 32rpx rgba(232, 115, 74, .42); }

/* 表单 */
.sheet-body { padding: 8rpx 40rpx 16rpx; }
.form-block { margin-bottom: 28rpx; }
.form-block:last-child { margin-bottom: 4rpx; }
.field { gap: 16rpx; }
.field-opt { color: var(--text3); font-size: 20rpx; font-weight: 500; }
.picker-val { color: var(--text); font-size: 30rpx; }
.g-chip { gap: 8rpx; padding: 12rpx 24rpx; font-size: 24rpx; font-weight: 600; }
.cuisine-scroll { margin-top: 16rpx; white-space: nowrap; }
.cuisine-row { display: inline-flex; gap: 12rpx; padding-bottom: 4rpx; }
.cuisine-row .chip { flex-shrink: 0; }
.sheet-foot { display: flex; gap: 20rpx; padding: 20rpx 40rpx calc(28rpx + env(safe-area-inset-bottom)); }
