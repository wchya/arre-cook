.mp-screen { height: 100vh; }
.diary-content { padding-top: 36rpx; }
.diary-content .mp-header { margin-bottom: 28rpx; }
.segmented-control { display: flex; padding: 5rpx; border: 1px solid #dfe2db; border-radius: 10rpx; background: #eeefe9; }
.segment { height: 65rpx; flex: 1; padding: 0; border-radius: 7rpx; background: transparent; color: #66736a; font-size: 21rpx; line-height: 65rpx; }
.segment-active { background: #fffefa; color: #1f2924; font-weight: 800; box-shadow: 0 2rpx 7rpx rgba(40, 45, 37, .08); }
.diary-error { margin-top: 20rpx; }
.diary-list-heading { margin: 31rpx 0 13rpx; }
.add-button { height: 60rpx; padding: 0 17rpx; border-radius: 8rpx; background: #1f2924; color: #fff; font-size: 20rpx; line-height: 60rpx; }
.entry-form { margin-bottom: 23rpx; }
.form-title { margin-bottom: 20rpx; color: #27352c; font-size: 25rpx; font-weight: 800; }
.form-grid { display: flex; gap: 14rpx; }
.form-grid .form-field { flex: 1; min-width: 0; }
.form-field { display: block; margin-bottom: 16rpx; color: #465349; font-size: 19rpx; font-weight: 700; }
.form-field > text { display: block; margin-bottom: 8rpx; }
.picker-value { height: 74rpx; padding: 0 15rpx; border: 1px solid #d9ded7; border-radius: 8rpx; background: #fff; color: #27352c; font-size: 20rpx; line-height: 74rpx; }
.food-groups { display: flex; flex-wrap: wrap; }
.food-group { display: flex; align-items: center; min-height: 55rpx; padding: 0 12rpx 0 0; color: #506056; font-size: 18rpx; font-weight: 500; }
.food-group checkbox { transform: scale(.75); margin-right: -4rpx; }
.notes-input { box-sizing: border-box; width: 100%; min-height: 100rpx; padding: 14rpx; border: 1px solid #d9ded7; border-radius: 8rpx; background: #fff; color: #1f2924; font-size: 21rpx; }
.save-button { margin-top: 7rpx; }
.loading-note { padding: 35rpx 5rpx; color: #68756c; font-size: 20rpx; text-align: center; }
.journal-empty { margin-top: 22rpx; }
.empty-title { margin-bottom: 8rpx; color: #27352c; font-size: 24rpx; font-weight: 800; }
.empty-add { margin-top: 20rpx; }
.journal-list { margin-top: 24rpx; border-top: 1px solid #dfe2db; }
.journal-item { padding: 20rpx 2rpx; border-bottom: 1px solid #dfe2db; }
.journal-date { display: flex; align-items: center; color: #67736a; font-size: 18rpx; }
.date-dot { width: 10rpx; height: 10rpx; margin-right: 9rpx; border-radius: 50%; background: #c36c45; }
.meal-label { margin-left: 10rpx; color: #839087; }
.journal-main { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; }
.journal-dish { color: #26342b; font-size: 24rpx; font-weight: 800; }
.delete-button { height: 44rpx; padding: 0 10rpx; color: #9a4b38; font-size: 18rpx; line-height: 44rpx; }
.journal-cuisine { margin-top: 7rpx; color: #627167; font-size: 19rpx; }
.journal-tags { display: flex; flex-wrap: wrap; margin-top: 9rpx; }
.journal-tag { padding: 5rpx 10rpx; margin: 0 7rpx 4rpx 0; border-radius: 5rpx; background: #eaf2eb; color: #38664a; font-size: 17rpx; }
.journal-notes { margin-top: 7rpx; color: #748078; font-size: 19rpx; line-height: 1.5; }
.period-switch { display: flex; margin-top: 24rpx; border-bottom: 1px solid #dfe2db; }
.period-button { position: relative; height: 65rpx; flex: 1; color: #68756c; font-size: 20rpx; line-height: 65rpx; }
.period-active { color: #286c49; font-weight: 800; }
.period-active::after { position: absolute; right: 25%; bottom: -1px; left: 25%; height: 4rpx; border-radius: 99rpx; background: #2f8a61; content: ""; }
.report-summary { display: flex; align-items: center; margin-top: 23rpx; padding: 26rpx 19rpx; border: 1px solid #dce5dc; border-radius: 12rpx; background: #eef6ef; }
.summary-metric { display: flex; align-items: baseline; flex: 1; }
.metric-value { color: #255d40; font-size: 42rpx; font-weight: 800; }
.metric-unit { margin-left: 5rpx; color: #456b51; font-size: 18rpx; }
.metric-label { margin-left: 10rpx; color: #5b7061; font-size: 17rpx; }
.summary-divider { width: 1px; height: 45rpx; margin: 0 20rpx; background: #c9d8ca; }
.report-caveat { margin-top: 13rpx; color: #758078; font-size: 17rpx; line-height: 1.5; }
.insight-list, .cuisine-list, .plan-list { margin-top: 15rpx; border-top: 1px solid #dfe2db; }
.insight-row { display: flex; gap: 11rpx; padding: 16rpx 3rpx; border-bottom: 1px solid #dfe2db; color: #526158; font-size: 20rpx; line-height: 1.55; }
.insight-mark { width: 9rpx; height: 9rpx; flex: 0 0 9rpx; margin-top: 10rpx; border-radius: 50%; background: #c36c45; }
.report-empty { margin-top: 15rpx; color: #67736a; font-size: 20rpx; }
.cuisine-row { display: flex; justify-content: space-between; padding: 14rpx 4rpx; border-bottom: 1px solid #dfe2db; color: #526158; font-size: 20rpx; }
.cuisine-count { color: #286c49; font-weight: 700; }
.plan-item { display: flex; align-items: flex-start; gap: 12rpx; padding: 14rpx 4rpx; border-bottom: 1px solid #dfe2db; color: #526158; font-size: 20rpx; line-height: 1.5; }
.plan-number { width: 28rpx; height: 28rpx; flex: 0 0 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e4efe5; color: #286c49; font-size: 17rpx; font-weight: 800; }
.chat-link { display: flex; align-items: center; justify-content: center; width: 100%; height: 76rpx; margin-top: 28rpx; border: 1px solid #ceddce; border-radius: 9rpx; background: #f1f8f1; color: #286c49; font-size: 21rpx; font-weight: 700; }
