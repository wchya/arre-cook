.conn-hero { margin-bottom: 28rpx; padding: 32rpx; border-radius: 40rpx; background: linear-gradient(140deg, var(--purple-light), var(--card) 58%, var(--primary-light)); }
.conn-hero__title { display: flex; align-items: center; gap: 12rpx; color: var(--text); font-size: 30rpx; font-weight: 800; }
.conn-hero__item { position: relative; margin-top: 12rpx; padding-left: 24rpx; color: var(--text2); font-size: 24rpx; line-height: 1.7; }
.conn-hero__item::before { position: absolute; left: 0; content: "·"; color: var(--text3); }

.conn-stats { margin-bottom: 24rpx; }
.conn-sk { height: 220rpx; border-radius: 32rpx; }
.conn-list { display: flex; flex-direction: column; gap: 20rpx; }

.tk { display: flex; align-items: flex-start; gap: 24rpx; }
.tk__avatar { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; flex-shrink: 0; border-radius: 28rpx; background: var(--purple-light); color: var(--purple); font-size: 32rpx; font-weight: 800; }
.tk__body { min-width: 0; }
.tk__head { display: flex; align-items: center; gap: 12rpx; }
.tk__name { color: var(--text); font-size: 30rpx; font-weight: 800; }
.tk__prefix { flex-shrink: 0; padding: 2rpx 12rpx; border-radius: 8rpx; background: var(--bg); color: var(--text3); font-size: 20rpx; font-family: monospace; }
.tk__meta { margin-top: 6rpx; color: var(--text3); font-size: 22rpx; }
.tk__scopes { margin-top: 16rpx; }
.tk__acts { display: flex; flex-shrink: 0; gap: 12rpx; }
.tk__act { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 20rpx; }
.tk__act--danger { background: rgba(220, 38, 38, .1); }
.conn-inactive { padding-top: 8rpx; color: var(--text4); font-size: 22rpx; text-align: center; }

.conn-snip { margin-top: 28rpx; }
.snip-tabs { margin: 20rpx 0 8rpx; white-space: nowrap; }
.snip-tab { display: inline-flex; align-items: center; height: 60rpx; margin-right: 12rpx; padding: 0 26rpx; border-radius: 999rpx; background: var(--bg); color: var(--text2); font-size: 24rpx; font-weight: 700; }
.snip-tab.is-active { background: var(--text); color: var(--bg); }
.snip-note { margin: 8rpx 0 16rpx; color: var(--text3); font-size: 22rpx; line-height: 1.6; }
.code { position: relative; }
.code__scroll { max-height: 520rpx; padding: 28rpx; padding-right: 84rpx; border-radius: 24rpx; background: #1d1d22; }
.code__text { color: #e8e8ee; font-size: 22rpx; font-family: monospace; line-height: 1.7; white-space: pre; }
.code__copy { position: absolute; top: 16rpx; right: 16rpx; display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 18rpx; background: rgba(255, 255, 255, .14); }

.conn-audit { display: flex; flex-direction: column; }
.audit { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 0; }
.audit + .audit { border-top: 1px solid var(--border); }
.audit__dot { width: 16rpx; height: 16rpx; flex-shrink: 0; border-radius: 50%; background: var(--text4); }
.audit__dot.is-ok { background: var(--mint); }
.audit__dot.is-warn { background: var(--yellow); }
.audit__dot.is-bad { background: var(--red); }
.audit__main { color: var(--text); font-size: 26rpx; font-weight: 600; }
.audit__tool { color: var(--text2); font-family: monospace; font-size: 24rpx; font-weight: 500; }
.audit__err { margin-top: 2rpx; color: var(--red); font-size: 22rpx; }
.audit__time { flex-shrink: 0; color: var(--text3); font-size: 22rpx; }
.conn-audit-empty { padding: 40rpx 0; color: var(--text3); font-size: 24rpx; text-align: center; }

.sheet-body { padding: 8rpx 40rpx 24rpx; }
.preset-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 12rpx; }
.preset { display: flex; align-items: flex-start; gap: 20rpx; padding: 24rpx; border: 3rpx solid var(--border); border-radius: 28rpx; background: var(--bg); transition: border-color .2s ease, background-color .2s ease; }
.preset.is-active { border-color: var(--primary); background: var(--primary-light); }
.preset__radio { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; flex-shrink: 0; margin-top: 2rpx; border: 4rpx solid var(--border2); border-radius: 50%; }
.preset.is-active .preset__radio { border-color: var(--primary); background: var(--primary); }
.preset__title { color: var(--text); font-size: 28rpx; font-weight: 700; }
.preset__desc { margin-top: 4rpx; color: var(--text2); font-size: 22rpx; line-height: 1.6; }
.expire { display: flex; align-items: center; justify-content: center; height: 80rpx; border: 3rpx solid var(--border); border-radius: 24rpx; background: var(--bg); color: var(--text2); font-size: 24rpx; font-weight: 700; }
.expire.is-active { border-color: var(--mint); background: var(--mint-light); color: var(--mint-ink); }

.conn-warn { margin-bottom: 24rpx; line-height: 1.7; }
.token-box { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; border-radius: 24rpx; background: var(--bg); }
.token-box__text { flex: 1; min-width: 0; color: var(--text); font-size: 24rpx; font-family: monospace; word-break: break-all; }
.conn-mcp { margin-top: 20rpx; color: var(--text2); font-size: 24rpx; line-height: 1.7; }
.conn-mcp__url { color: var(--primary); font-family: monospace; font-size: 22rpx; word-break: break-all; }
.conn-mcp--sub { color: var(--text3); font-size: 22rpx; }
