.mp-screen { height: 100vh; }
.agent-content { padding-top: 36rpx; }
.agent-callout { display: flex; align-items: center; padding: 19rpx; border: 1px solid #d6e3d7; border-radius: 12rpx; background: #edf5ee; }
.callout-mark { width: 58rpx; height: 58rpx; flex: 0 0 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; background: #2d744f; color: #fff; font-family: Georgia, serif; font-size: 27rpx; font-weight: 700; }
.callout-copy { min-width: 0; flex: 1; padding: 0 14rpx; }
.callout-title { color: #254f36; font-size: 22rpx; font-weight: 800; }
.callout-text { margin-top: 5rpx; color: #54705a; font-size: 17rpx; line-height: 1.4; }
.chat-button { height: 54rpx; padding: 0 15rpx; border-radius: 7rpx; background: #2d744f; color: #fff; font-size: 18rpx; line-height: 54rpx; }
.agent-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 22rpx; border-top: 1px solid #dfe2db; border-bottom: 1px solid #dfe2db; }
.agent-stat { display: flex; flex-direction: column; align-items: center; padding: 17rpx 4rpx; border-right: 1px solid #dfe2db; }
.agent-stat:last-child { border-right: 0; }
.stat-value { color: #263a2d; font-size: 31rpx; font-weight: 800; }
.stat-label { margin-top: 4rpx; color: #68756c; font-size: 16rpx; text-align: center; }
.agent-list-heading { margin: 31rpx 0 13rpx; }
.create-button { height: 58rpx; padding: 0 17rpx; border-radius: 8rpx; background: #1f2924; color: #fff; font-size: 19rpx; line-height: 58rpx; }
.create-panel { margin-bottom: 18rpx; }
.create-title { margin-bottom: 18rpx; color: #27352c; font-size: 24rpx; font-weight: 800; }
.agent-field { display: block; margin-bottom: 15rpx; color: #465349; font-size: 18rpx; font-weight: 700; }
.agent-field > text { display: block; margin-bottom: 7rpx; }
.picker-value { overflow: hidden; height: 70rpx; padding: 0 13rpx; border: 1px solid #d9ded7; border-radius: 8rpx; background: #fff; color: #27352c; font-size: 18rpx; line-height: 70rpx; text-overflow: ellipsis; white-space: nowrap; }
.form-error { margin-bottom: 12rpx; }
.form-actions { display: flex; gap: 12rpx; margin-top: 20rpx; }
.cancel-button, .create-submit { height: 74rpx; flex: 1; border-radius: 8rpx; font-size: 20rpx; line-height: 74rpx; }
.cancel-button { border: 1px solid #d9ded7; color: #506056; }
.create-submit { min-height: 74rpx; }
.new-token-panel { padding: 20rpx; margin-top: 16rpx; border: 1px solid #b8d7c2; border-radius: 12rpx; background: #eaf5ed; }
.new-token-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.new-token-title { color: #255d40; font-size: 23rpx; font-weight: 800; }
.dismiss-button { color: #326b49; font-size: 17rpx; }
.token-value { overflow-wrap: anywhere; padding: 13rpx; margin-top: 15rpx; border: 1px solid #d2e3d5; border-radius: 7rpx; background: #fff; color: #33463a; font-family: monospace; font-size: 18rpx; line-height: 1.5; }
.copy-button { height: 57rpx; padding: 0 16rpx; margin-top: 12rpx; border-radius: 7rpx; background: #2d744f; color: #fff; font-size: 19rpx; line-height: 57rpx; }
.agent-empty { margin-top: 15rpx; }
.empty-title { margin-bottom: 7rpx; color: #27352c; font-size: 23rpx; font-weight: 800; }
.empty-create { margin-top: 18rpx; }
.token-list { margin-top: 14rpx; border-top: 1px solid #dfe2db; }
.token-row { padding: 19rpx 2rpx; border-bottom: 1px solid #dfe2db; }
.token-top { display: flex; align-items: center; justify-content: space-between; }
.token-name { color: #26342b; font-size: 23rpx; font-weight: 800; }
.token-state { padding: 5rpx 9rpx; border-radius: 5rpx; font-size: 16rpx; }
.token-on { background: #e7f2e8; color: #2e704a; }
.token-off { background: #f3e9e5; color: #8b4b39; }
.token-prefix { margin-top: 7rpx; color: #637168; font-family: monospace; font-size: 18rpx; }
.token-scopes { margin-top: 7rpx; color: #4b6452; font-size: 18rpx; }
.token-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 9rpx; color: #737e75; font-size: 17rpx; }
.revoke-button { height: 44rpx; padding: 0 10rpx; color: #a04431; font-size: 18rpx; line-height: 44rpx; }
.audit-list { margin-top: 10rpx; border-top: 1px solid #dfe2db; }
.audit-row { display: flex; align-items: center; padding: 14rpx 2rpx; border-bottom: 1px solid #dfe2db; }
.audit-status { width: 11rpx; height: 11rpx; flex: 0 0 11rpx; margin-right: 12rpx; border-radius: 50%; }
.audit-ok { background: #3d9664; }
.audit-fail { background: #ba5b40; }
.audit-main { min-width: 0; flex: 1; }
.audit-tool { overflow: hidden; color: #29372e; font-size: 19rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.audit-meta { margin-top: 4rpx; color: #737e75; font-size: 16rpx; }
.audit-result { margin-left: 10rpx; color: #5b6b60; font-size: 17rpx; }
.audit-empty { padding: 22rpx 0; color: #707c73; font-size: 19rpx; text-align: center; }
.agent-note { margin-top: 28rpx; color: #758078; font-size: 17rpx; line-height: 1.55; }
