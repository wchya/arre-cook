.sk { height: 220rpx; margin-bottom: 24rpx; border-radius: 44rpx; }
.sec { margin-bottom: 24rpx; padding: 32rpx; border-radius: 44rpx; }
.sec__title { color: var(--text); font-size: 30rpx; font-weight: 800; }
.sec__hint { margin: 4rpx 0 24rpx; color: var(--text3); font-size: 22rpx; line-height: 1.6; }
.grid-5 { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12rpx; }
.spice { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; padding: 20rpx 0; border: 3rpx solid var(--border); border-radius: 32rpx; background: var(--bg); color: var(--text2); font-size: 22rpx; font-weight: 700; transition: all .2s ease; }
.spice.is-active { border-color: var(--primary); background: var(--primary-light); color: var(--primary); }
.spice.time { min-height: 88rpx; font-size: 22rpx; }
.spice.is-mint { border-color: var(--mint); background: var(--mint-light); color: var(--mint-ink); }
.spice__emoji { font-size: 30rpx; line-height: 1.2; }
.pill { padding: 12rpx 24rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--bg); color: var(--text2); font-size: 24rpx; font-weight: 600; transition: all .2s ease; }
.pill--pink { border-color: var(--pink); background: var(--pink); color: #fff; }
.pill--purple { border-color: var(--purple); background: var(--purple-light); color: var(--purple); }
.household { display: flex; align-items: center; gap: 24rpx; }
.household__btn { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border: 1px solid var(--border); border-radius: 50%; background: var(--bg); }
.household__btn.is-off { opacity: .4; }
.household__value { min-width: 144rpx; color: var(--text); font-size: 36rpx; font-weight: 900; text-align: center; }
.bottom-space { height: calc(180rpx + env(safe-area-inset-bottom)); }
.save-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 90; padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 1px solid var(--border); background: rgba(250, 250, 248, .92); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); }
