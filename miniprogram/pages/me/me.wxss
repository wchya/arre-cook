.mp-screen { height: 100vh; }
.me-content { padding-top: 36rpx; }
.profile-panel { display: flex; align-items: center; padding: 23rpx 0; border-top: 1px solid #dfe2db; border-bottom: 1px solid #dfe2db; }
.profile-avatar { width: 100rpx; height: 100rpx; flex: 0 0 100rpx; border-radius: 26rpx; background: #e9efe8; }
.profile-initial { display: flex; align-items: center; justify-content: center; background: #1f2924; color: #fff; font-size: 39rpx; font-weight: 800; }
.profile-details { min-width: 0; padding-left: 18rpx; }
.profile-name { overflow: hidden; color: #1f2924; font-size: 28rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.profile-email { overflow: hidden; margin-top: 6rpx; color: #66736a; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.profile-state { display: inline-block; padding: 5rpx 9rpx; margin-top: 9rpx; border-radius: 5rpx; background: #eaf3ea; color: #35694a; font-size: 16rpx; }
.stats-row { display: flex; margin-top: 17rpx; border: 1px solid #e0e3dc; border-radius: 10rpx; background: #fffefa; }
.personal-stat { display: flex; flex: 1; flex-direction: column; align-items: center; padding: 18rpx 4rpx; border-right: 1px solid #e5e7e1; }
.personal-stat:last-child { border-right: 0; }
.personal-value { color: #26372c; font-size: 30rpx; font-weight: 800; }
.personal-label { margin-top: 5rpx; color: #6f7b72; font-size: 17rpx; text-align: center; }
.account-section { padding: 0 18rpx; border: 1px solid #e0e3dc; border-radius: 12rpx; background: #fffefa; }
.account-link { display: flex; align-items: center; min-height: 108rpx; border-bottom: 1px solid #e6e8e2; }
.account-link:last-child { border-bottom: 0; }
.link-mark { width: 52rpx; height: 52rpx; flex: 0 0 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 13rpx; font-size: 19rpx; font-weight: 800; }
.mark-green { background: #e7f1e8; color: #34724c; }
.mark-coral { background: #f8ece6; color: #a85c3d; }
.mark-gold { background: #f6f0df; color: #806334; }
.link-copy { min-width: 0; flex: 1; padding-left: 14rpx; }
.link-title { color: #2a382f; font-size: 20rpx; font-weight: 800; }
.link-desc { margin-top: 5rpx; color: #747f76; font-size: 17rpx; }
.link-arrow { padding: 0 5rpx 3rpx 12rpx; color: #8b968d; font-size: 36rpx; }
.account-note { margin: 24rpx 2rpx; color: #6c786f; font-size: 18rpx; line-height: 1.6; }
.logout-button { height: 76rpx; border: 1px solid #e6cbc1; border-radius: 9rpx; background: #fff8f4; color: #9d4933; font-size: 21rpx; font-weight: 700; line-height: 76rpx; }
