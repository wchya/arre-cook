.sk-a { height: 380rpx; margin-bottom: 32rpx; border-radius: 48rpx; }
.sk-b { height: 360rpx; margin-bottom: 32rpx; border-radius: 48rpx; }
.head-icon { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; flex-shrink: 0; border-radius: 28rpx; }
.summary-title { color: var(--text); font-size: 44rpx; font-weight: 800; line-height: 1.2; letter-spacing: -.5rpx; }
.summary-date { margin-top: 2rpx; color: var(--text3); font-size: 24rpx; font-weight: 600; }
.save-state { flex-shrink: 0; padding: 6rpx 24rpx; border-radius: 999rpx; background: var(--yellow-light); color: var(--yellow-dark); font-size: 22rpx; font-weight: 800; }
.save-state.is-saved { background: var(--mint-light); color: var(--mint-ink); }
.mini { padding: 20rpx 24rpx; border-radius: 32rpx; background: var(--bg); }
.mini__label { overflow: hidden; color: var(--text3); font-size: 22rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.mini__value { color: var(--text); font-size: 30rpx; font-weight: 800; line-height: 1.4; }

.block-title { color: var(--text); font-size: 30rpx; font-weight: 800; }
.block-sub { color: var(--text3); font-size: 22rpx; font-weight: 500; }
.try-btn { display: flex; align-items: center; gap: 8rpx; height: 64rpx; padding: 0 24rpx; border-radius: 999rpx; background: var(--card); border: 1px solid var(--border); color: var(--text2); font-size: 24rpx; font-weight: 800; }

.profiles { margin: 0 -40rpx; padding: 0 40rpx 8rpx; white-space: nowrap; }
.profile { display: inline-flex; align-items: center; gap: 16rpx; min-width: 172rpx; margin-right: 16rpx; padding: 16rpx 24rpx 16rpx 16rpx; border: 1px solid var(--border); border-radius: 32rpx; background: var(--card); color: var(--text2); vertical-align: top; transition: all .2s ease; }
.profile.is-active { border-color: var(--primary); background: var(--primary-light); color: var(--primary); }
.profile__icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; flex-shrink: 0; border-radius: 22rpx; background: var(--bg); }
.profile.is-active .profile__icon { background: var(--card); }
.profile__label { font-size: 26rpx; font-weight: 700; line-height: 1.3; }
.profile__hint { font-size: 20rpx; font-weight: 500; opacity: .7; }

.planner { overflow: hidden; border-radius: 48rpx; }
.planner__head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 32rpx; border-bottom: 1px solid var(--border); }
.planner__icon { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 30rpx; }
.planner__title { color: var(--text); font-size: 34rpx; font-weight: 800; line-height: 1.3; }
.planner__helper { margin-top: 2rpx; color: var(--text3); font-size: 22rpx; font-weight: 600; }
.stepper { display: flex; align-items: center; height: 64rpx; overflow: hidden; border: 1px solid var(--border); border-radius: 999rpx; background: var(--bg); }
.stepper__btn { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; }
.stepper__btn.is-off { opacity: .3; }
.stepper__value { width: 48rpx; color: var(--text); font-size: 28rpx; font-weight: 800; text-align: center; }
.planner__body { padding: 0 32rpx; }
.planner__empty { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0; text-align: center; }
.planner__empty-icon { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin-bottom: 20rpx; border-radius: 32rpx; }
.plan-dish { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; }
.plan-dish + .plan-dish { border-top: 1px solid var(--border); }
.plan-dish__thumb { width: 128rpx; height: 128rpx; flex-shrink: 0; overflow: hidden; border-radius: 32rpx; }
.plan-dish__name { margin-bottom: 10rpx; color: var(--text); font-size: 30rpx; font-weight: 800; }
.plan-dish__chips { gap: 10rpx; }
.round-btn { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; flex-shrink: 0; border-radius: 50%; }
.planner__foot { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; padding: 24rpx 32rpx; border-top: 1px solid var(--border); background: var(--bg); }
.foot-btn { display: flex; align-items: center; justify-content: center; gap: 8rpx; height: 80rpx; border-radius: 32rpx; background: var(--card); color: var(--text2); font-size: 24rpx; font-weight: 800; }
.foot-btn.is-off { opacity: .45; }

.bottom-space { height: calc(200rpx + env(safe-area-inset-bottom)); }
.save-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 90; display: flex; align-items: center; gap: 24rpx; padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 1px solid var(--glass-border); background: var(--bg); box-shadow: 0 -20rpx 56rpx rgba(26, 26, 46, .07); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); }
.save-bar__title { color: var(--text2); font-size: 24rpx; font-weight: 700; }
.save-bar__sub { color: var(--text3); font-size: 22rpx; font-weight: 500; }
.save-btn { min-width: 280rpx; height: 96rpx; font-weight: 800; }

.picker-head { padding: 0 40rpx 16rpx; }
.picker-input { margin-left: 12rpx; }
.picker-cats { margin-top: 20rpx; white-space: nowrap; }
.picker-cat { display: inline-block; margin-right: 16rpx; padding: 10rpx 28rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--bg); color: var(--text2); font-size: 24rpx; font-weight: 700; }
.picker-cat.is-active { border-color: var(--primary); background: var(--primary); color: #fff; }
.picker-list { max-height: 56vh; padding: 0 40rpx 24rpx; }
.picker-sk { height: 128rpx; margin-bottom: 16rpx; border-radius: 32rpx; }
.picker-row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; }
.picker-row + .picker-row { border-top: 1px solid var(--border); }
.picker-row__thumb { width: 112rpx; height: 112rpx; flex-shrink: 0; overflow: hidden; border-radius: 32rpx; }
.picker-row__name { color: var(--text); font-size: 28rpx; font-weight: 800; }
.picker-row__meta { margin-top: 6rpx; color: var(--text3); font-size: 22rpx; font-weight: 500; }
.pick-btn { display: flex; align-items: center; gap: 6rpx; height: 64rpx; flex-shrink: 0; padding: 0 24rpx; border-radius: 999rpx; background: var(--primary); color: #fff; font-size: 24rpx; font-weight: 800; }
.pick-btn--mint { background: var(--mint); }
.pick-btn--remove { background: var(--red-light); color: var(--red); }
.pick-btn--off { background: var(--bg); color: var(--text3); font-size: 22rpx; }
