.meta-pill { padding: 6rpx 18rpx; border-radius: 999rpx; background: var(--primary-light); color: var(--primary); font-size: 22rpx; font-weight: 700; }

.intro { margin-bottom: 36rpx; color: var(--text2); font-size: 26rpx; line-height: 1.7; text-align: center; }

.tl { position: relative; }
.tl::before { position: absolute; left: 20rpx; top: 16rpx; bottom: 16rpx; width: 3rpx; background: var(--border); content: ""; }
.tl-item { position: relative; padding-left: 72rpx; margin-bottom: 44rpx; }
.tl-dot { position: absolute; left: 12rpx; top: 14rpx; z-index: 1; width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--primary); box-shadow: 0 0 0 8rpx var(--primary-light); }

.day-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12rpx; margin-bottom: 20rpx; }
.day-md { color: var(--text); font-size: 40rpx; font-weight: 800; letter-spacing: -0.5rpx; }
.day-sub { color: var(--text3); font-size: 22rpx; font-weight: 500; }
.day-moods { margin-left: auto; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; }
.mood-chip { display: inline-flex; align-items: center; gap: 6rpx; padding: 4rpx 16rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--card); color: var(--text2); font-size: 22rpx; font-weight: 500; }
.mood-chip--home { border-color: rgba(232, 115, 74, .12); background: var(--primary-light); color: var(--primary); }
.mood-emoji { font-size: 26rpx; }

.memory { padding: 24rpx; }
.photos { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.photos--single { grid-template-columns: 1fr; }
.photo { position: relative; }
.photo__frame { padding: 12rpx 12rpx 36rpx; border: 1px solid #F0EEE9; border-radius: 8rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .12); }
.photo__img { display: block; width: 100%; height: 280rpx; border-radius: 4rpx; background: var(--bg); }
.photo__img--single { height: 420rpx; }
.photo__more { position: absolute; top: 12rpx; right: 12rpx; bottom: 36rpx; left: 12rpx; display: flex; align-items: center; justify-content: center; border-radius: 4rpx; background: rgba(0, 0, 0, .45); color: #fff; font-size: 36rpx; font-weight: 600; }

.memory__remark { margin-top: 16rpx; padding: 0 4rpx; color: var(--text2); font-size: 26rpx; font-style: italic; line-height: 1.7; }
.memory__records { display: flex; flex-direction: column; gap: 14rpx; margin-top: 20rpx; padding-top: 20rpx; border-top: 1px dashed var(--border); }
.rec { display: flex; align-items: center; gap: 12rpx; }
.rec__dot { width: 12rpx; height: 12rpx; flex-shrink: 0; border-radius: 50%; }
.rec__dot--lunch { background: var(--primary); }
.rec__dot--dinner { background: var(--mint); }
.rec__meal { flex-shrink: 0; width: 56rpx; color: var(--text3); font-size: 22rpx; }
.rec__name { flex: 1; min-width: 0; color: var(--text); font-size: 26rpx; font-weight: 500; }
.rec__mood { margin-left: auto; display: flex; flex-shrink: 0; align-items: center; gap: 6rpx; }
.rec__moodtext { color: var(--text3); font-size: 22rpx; }

.tl-end { display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 20rpx 0 32rpx; color: var(--text3); font-size: 22rpx; }
.tl-end__line { width: 48rpx; height: 1px; background: var(--border2); }

.empty-card { padding: 24rpx; }
.sk-title { width: 200rpx; height: 40rpx; margin-bottom: 20rpx; border-radius: 8rpx; }
.sk-card { width: 100%; height: 320rpx; border-radius: 32rpx; }
.safe-space { height: calc(48rpx + env(safe-area-inset-bottom)); }
