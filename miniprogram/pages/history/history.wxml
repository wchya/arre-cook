<view class="screen">
  <nav-bar icon="calendar-days" title="记录" subtitle="查看日历、评价和最近吃过的菜" theme="plain">
    <view class="nav-btn" hover-class="tap-active" bindtap="goPhotoWall" aria-role="button" aria-label="照片墙">
      <icon name="images" size="34" stroke="2.3" color="text2" />
    </view>
  </nav-bar>

  <scroll-view class="screen-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-background="#FAFAF8" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindtap="closeSwipe">
    <view class="content anim-fade-up">
      <!-- 日历 -->
      <view class="card calendar">
        <view class="calendar__head">
          <view class="calendar__title">{{year}} 年 {{month + 1}} 月</view>
          <view class="flex gap-16">
            <view class="month-btn" hover-class="tap-active" data-step="-1" catchtap="changeMonth" aria-role="button" aria-label="上个月"><icon name="chevron-left" size="28" stroke="2.6" color="text2" /></view>
            <view class="month-btn" hover-class="tap-active" data-step="1" catchtap="changeMonth" aria-role="button" aria-label="下个月"><icon name="chevron-right" size="28" stroke="2.6" color="text2" /></view>
          </view>
        </view>
        <view class="calendar__grid">
          <view wx:for="{{weekHead}}" wx:key="*this" class="calendar__week">{{item}}</view>
          <view wx:for="{{cells}}" wx:key="key" class="day {{item.other ? 'is-other' : ''}} {{item.today ? 'is-today' : ''}} {{selectedKey === item.key ? 'is-selected' : ''}}" data-key="{{item.other ? '' : item.key}}" catchtap="selectDay">
            <text>{{item.day}}</text>
            <view wx:if="{{item.dot}}" class="day__dot dot-{{item.dot}}"></view>
            <text wx:if="{{item.mood}}" class="day__mood">{{item.mood}}</text>
          </view>
        </view>
        <view class="legend">
          <view class="legend__item"><view class="legend__dot dot-lunch"></view>午餐</view>
          <view class="legend__item"><view class="legend__dot dot-dinner"></view>晚餐</view>
          <view class="legend__item"><view class="legend__dot dot-both"></view>两餐都有</view>
        </view>
      </view>

      <!-- 选中日期 -->
      <view wx:if="{{selectedKey}}" class="card day-panel anim-pop-soft">
        <view class="day-panel__head">
          <view class="flex items-center wrap gap-12">
            <text>{{selectedLabel}}</text>
            <text wx:if="{{isToday}}" class="tag-today">今天</text>
            <text wx:if="{{dayRating && dayRating.homeMood}}" class="tag-mood">{{dayRating.homeMood}}</text>
          </view>
          <view class="rate-btn {{dayRating && dayRating.mood ? 'is-done' : ''}}" hover-class="tap-active" catchtap="openDayRate">{{dayRating && dayRating.mood ? '✓ 已评价' : '😌 评价'}}</view>
        </view>

        <view wx:if="{{!dayRecords.length}}" class="day-panel__empty">{{isToday ? '今天还没有记录哦~' : '这天没有记录'}}</view>
        <view wx:for="{{dayRecords}}" wx:key="id" class="swipe {{swipeId === 'd' + item.id ? 'is-open' : ''}}" data-swipe="{{'d' + item.id}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
          <view class="swipe__action" data-id="{{item.id}}" catchtap="deleteRecord"><icon name="trash-2" size="32" stroke="2.2" color="white" /><text>删除</text></view>
          <view class="swipe__content day-row" hover-class="tap-bg" data-id="{{item.dishId}}" catchtap="openDish">
            <view class="day-row__thumb {{item.meal === 'lunch' ? 'bg-lunch' : 'bg-dinner'}}"><dish-image src="{{item.cover}}" emoji="{{item.emoji}}" emoji-size="40" /></view>
            <view class="flex-1">
              <view class="row-title">{{item.name}}</view>
              <view class="row-desc">{{item.mealLabel}}</view>
            </view>
            <view wx:if="{{item.mood}}" class="mood-pill" data-id="{{item.id}}" catchtap="openRate"><text class="mood-pill__emoji">{{item.moodEmoji}}</text><text wx:if="{{item.remark}}" class="mood-pill__text truncate">{{item.remark}}</text></view>
            <view wx:else class="chip chip-primary rate-chip" data-id="{{item.id}}" catchtap="openRate">评价</view>
          </view>
        </view>

        <view wx:if="{{dayRating && dayRating.mood}}" class="day-summary">
          <text class="day-summary__icon">🍚</text>
          <view class="flex-1 c-text2">{{dayRecords.length > 1 ? '午餐+晚餐' : '一餐'}} · 整体评价<text wx:if="{{dayRating.remark}}" class="c-text"> {{dayRating.remark}}</text></view>
          <text class="day-summary__icon">{{dayRating.moodEmoji || '😋'}}</text>
        </view>

        <view class="day-photos">
          <view class="t-xs c-text3 mb-16">{{dayPhotos.length ? '📷 照片 (' + dayPhotos.length + ')' : '📷 拍张照记录一下？'}}</view>
          <scroll-view class="photo-strip" scroll-x enhanced show-scrollbar="{{false}}">
            <view wx:for="{{dayPhotos}}" wx:key="raw" class="photo" data-index="{{index}}" catchtap="previewDayPhoto">
              <image class="photo__img" src="{{item.url}}" mode="aspectFill" lazy-load webp />
              <view class="photo__del" data-index="{{index}}" catchtap="removeDayPhoto" aria-role="button" aria-label="删除照片"><icon name="x" size="18" stroke="3" color="white" /></view>
            </view>
            <view class="photo photo--add" hover-class="tap-active" catchtap="openDayRate"><icon name="plus" size="32" stroke="2.4" color="text3" /><text>添加</text></view>
          </scroll-view>
        </view>
      </view>

      <!-- 统计 -->
      <view class="grid-2 stats">
        <view class="stat-card bar-primary"><view class="stat-value c-primary">{{stats ? stats.total_records : 0}}</view><view class="stat-label">累计做饭</view></view>
        <view class="stat-card bar-mint"><view class="stat-value is-small c-mint">{{topDish}}</view><view class="stat-label">最常吃的菜</view></view>
        <view class="stat-card bar-pink"><view class="stat-value c-pink">{{stats ? stats.lunch_count : 0}}</view><view class="stat-label">午餐次数</view></view>
        <view class="stat-card bar-yellow"><view class="stat-value c-yellow">{{stats ? stats.dinner_count : 0}}</view><view class="stat-label">晚餐次数</view></view>
      </view>

      <!-- 最近记录 -->
      <view class="section-head"><view class="section-title">最近记录</view><text wx:if="{{recent.length}}" class="t-xs c-text3">左滑可删除</text></view>
      <view wx:if="{{loading}}" class="flex-col gap-20">
        <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="skeleton recent-sk"></view>
      </view>
      <view wx:elif="{{!recent.length}}" class="card">
        <empty emoji="📅" title="还没有记录" desc="去首页推荐一道菜吧~" compact>
          <view class="btn btn-soft btn-sm" hover-class="tap-active" catchtap="goHome">去首页看看</view>
        </empty>
      </view>
      <view wx:else class="recent">
        <view wx:for="{{recent}}" wx:key="id" class="swipe swipe--card {{swipeId === 'r' + item.id ? 'is-open' : ''}}" data-swipe="{{'r' + item.id}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
          <view class="swipe__action" data-id="{{item.id}}" catchtap="deleteRecord"><icon name="trash-2" size="32" stroke="2.2" color="white" /><text>删除</text></view>
          <view class="swipe__content recent-row" hover-class="tap-bg" data-id="{{item.dishId}}" catchtap="openDish">
            <view class="recent-row__thumb {{item.meal === 'lunch' ? 'bg-lunch' : 'bg-dinner'}}"><dish-image src="{{item.cover}}" emoji="{{item.emoji}}" emoji-size="48" /></view>
            <view class="flex-1">
              <view class="row-title">{{item.name}}</view>
              <view class="row-desc">{{item.dateLabel}}</view>
            </view>
            <view wx:if="{{item.mood}}" class="mood-pill" data-id="{{item.id}}" catchtap="openRate"><text class="mood-pill__emoji">{{item.moodEmoji}}</text><text wx:if="{{item.remark}}" class="mood-pill__text truncate">{{item.remark}}</text></view>
            <view wx:else class="chip chip-primary rate-chip" data-id="{{item.id}}" catchtap="openRate">评价</view>
          </view>
        </view>
      </view>
    </view>
    <view class="tabbar-spacer"></view>
  </scroll-view>

  <!-- 单道菜评价 -->
  <sheet show="{{rateOpen}}" title="{{rateRecord ? rateRecord.name + ' — 这道菜怎么样？' : ''}}" bind:close="closeRate">
    <view class="sheet-body">
      <view class="mood-options">
        <view wx:for="{{dishMoods}}" wx:key="key" class="mood-option {{rateMood === item.key ? 'is-active' : ''}}" data-mood="{{item.key}}" bindtap="pickRateMood">
          <text class="mood-option__emoji">{{item.emoji}}</text><text class="mood-option__label">{{item.label}}</text>
        </view>
      </view>
      <view class="field-label">备注（可选）</view>
      <textarea class="field-textarea" value="{{rateRemark}}" maxlength="200" placeholder="这道菜怎么样..." placeholder-class="placeholder" auto-height cursor-spacing="120" bindinput="onRateRemark" />
      <view class="field-label mt-32">📷 成品照（可选，限 1 张）</view>
      <view wx:if="{{ratePhoto}}" class="upload-thumb" bindtap="previewRatePhoto">
        <image class="upload-thumb__img" src="{{ratePhoto}}" mode="aspectFill" webp />
        <view class="photo__del" catchtap="removeRatePhoto"><icon name="x" size="18" stroke="3" color="white" /></view>
      </view>
      <view wx:else class="upload-add" hover-class="tap-active" bindtap="uploadRatePhoto">
        <view wx:if="{{rateUploading}}" class="spinner spinner-dark"></view>
        <block wx:else><icon name="camera" size="36" stroke="2.2" color="text3" /><text>添加</text></block>
      </view>
    </view>
    <view slot="footer" class="sheet-footer">
      <view class="btn btn-block btn-primary {{rateMood && !rateSaving ? '' : 'is-disabled'}}" hover-class="tap-active" bindtap="saveRate">
        <view wx:if="{{rateSaving}}" class="spinner"></view><text wx:else>保存评价</text>
      </view>
    </view>
  </sheet>

  <!-- 整餐评价 -->
  <sheet show="{{dayOpen}}" title="🍲 这顿饭怎么样？" subtitle="评价 {{selectedKey}} 的整体用餐感受" bind:close="closeDayRate">
    <view class="sheet-body">
      <view class="mood-options">
        <view wx:for="{{mealMoods}}" wx:key="key" class="mood-option {{dayMood === item.key ? 'is-active' : ''}}" data-mood="{{item.key}}" bindtap="pickDayMood">
          <text class="mood-option__emoji">{{item.emoji}}</text><text class="mood-option__label">{{item.label}}</text>
        </view>
      </view>
      <view class="field-label">备注（可选）</view>
      <textarea class="field-textarea" value="{{dayRemark}}" maxlength="200" placeholder="今天这顿饭的整体感受..." placeholder-class="placeholder" auto-height cursor-spacing="120" bindinput="onDayRemark" />
      <view class="field-label mt-32">📷 上传照片（可选，最多 9 张）</view>
      <view class="upload-grid">
        <view class="upload-add" hover-class="tap-active" bindtap="addDayPhotos">
          <view wx:if="{{dayUploading}}" class="spinner spinner-dark"></view>
          <block wx:else><icon name="camera" size="36" stroke="2.2" color="text3" /><text>添加</text></block>
        </view>
        <view wx:for="{{dayDraftPhotos}}" wx:key="raw" class="upload-thumb" data-index="{{index}}" bindtap="previewDraftPhoto">
          <image class="upload-thumb__img" src="{{item.url}}" mode="aspectFill" webp />
          <view class="photo__del" data-index="{{index}}" catchtap="removeDraftPhoto"><icon name="x" size="18" stroke="3" color="white" /></view>
        </view>
      </view>
    </view>
    <view slot="footer" class="sheet-footer">
      <view class="btn btn-block btn-primary {{dayMood && !daySaving ? '' : 'is-disabled'}}" hover-class="tap-active" bindtap="saveDayRate">
        <view wx:if="{{daySaving}}" class="spinner"></view><text wx:else>保存评价</text>
      </view>
    </view>
  </sheet>
</view>
