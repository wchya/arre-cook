.acct-sk { height: 240rpx; border-radius: 32rpx; margin-bottom: 24rpx; }

.identity { display: flex; align-items: center; gap: 24rpx; padding: 32rpx; margin-bottom: 20rpx; }
.identity__avatar { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; flex-shrink: 0; border-radius: 32rpx; background: linear-gradient(135deg, var(--primary), var(--pink)); color: #fff; font-size: 44rpx; font-weight: 700; }
.identity__name { color: var(--text); font-size: 34rpx; font-weight: 700; }
.identity__sub { margin-top: 4rpx; color: var(--text3); font-size: 24rpx; }
.identity__badges { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }

.meta-row { display: flex; margin-bottom: 32rpx; padding: 24rpx 0; border-radius: 28rpx; background: var(--card); border: 1px solid var(--border); box-shadow: var(--shadow-card); }
.meta-cell { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.meta-cell + .meta-cell { border-left: 1px solid var(--border); }
.meta-k { color: var(--text3); font-size: 22rpx; }
.meta-v { color: var(--text); font-size: 28rpx; font-weight: 600; }

.tone-danger { background: var(--red-light); color: var(--red); }

.foot { margin-top: 40rpx; padding-bottom: 16rpx; color: var(--text4); font-size: 22rpx; text-align: center; }

.sheet-body { padding: 8rpx 40rpx 24rpx; }
.pw-block + .pw-block { margin-top: 24rpx; }
.pw-block .field-label { margin-top: 0; }
.eye { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-left: 8rpx; }
.pw-error { display: flex; align-items: center; gap: 8rpx; margin-top: 20rpx; color: var(--red); font-size: 24rpx; }

.export-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.export-cell { display: flex; flex-direction: column; align-items: center; gap: 6rpx; padding: 28rpx 12rpx; border-radius: 24rpx; background: var(--bg); }
.export-count { color: var(--text); font-size: 40rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.export-label { color: var(--text3); font-size: 22rpx; }
