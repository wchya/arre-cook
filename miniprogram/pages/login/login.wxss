page { background: #f2efe8; }
.page { box-sizing: border-box; height: 100vh; min-height: 0; background: #f2efe8; color: #252a27; }
.page-inner { box-sizing: border-box; min-height: 100%; padding: calc(34rpx + env(safe-area-inset-top)) 34rpx calc(46rpx + env(safe-area-inset-bottom)); }
.topbar { display: flex; align-items: flex-start; justify-content: space-between; }
.brand-kicker, .hero-overline, .section-kicker { color: #777c73; font-size: 17rpx; font-weight: 700; letter-spacing: 2.5rpx; }
.brand-name { margin-top: 10rpx; color: #252a27; font-family: Georgia, "Times New Roman", serif; font-size: 35rpx; font-weight: 700; letter-spacing: .5rpx; }
.issue-stamp { display: flex; align-items: center; gap: 10rpx; padding: 9rpx 12rpx 9rpx 9rpx; border: 1px solid #c9c4b8; border-radius: 7rpx; transform: rotate(2deg); }
.stamp-mark { width: 43rpx; height: 43rpx; display: flex; align-items: center; justify-content: center; background: #c9573d; color: #fff; font-size: 22rpx; line-height: 1; }
.stamp-copy { color: #c9573d; font-size: 16rpx; font-weight: 800; line-height: 1.2; letter-spacing: 1rpx; }
.hero { padding: 94rpx 0 44rpx; }
.hero-overline { color: #c9573d; font-size: 16rpx; letter-spacing: 3rpx; }
.hero-title { margin-top: 19rpx; color: #252a27; font-family: Georgia, "Songti SC", serif; font-size: 64rpx; font-weight: 700; line-height: 1.18; letter-spacing: -2rpx; }
.hero-accent { color: #c9573d; }
.hero-meta { display: flex; align-items: center; margin-top: 30rpx; }
.meta-index { color: #c9573d; font-family: Georgia, serif; font-size: 22rpx; font-weight: 700; }
.meta-rule { width: 72rpx; height: 1px; margin: 0 14rpx; background: #c9c4b8; }
.meta-copy { color: #777c73; font-size: 20rpx; }
.login-shell { padding: 32rpx 28rpx 30rpx; border: 1px solid #d8d3c8; border-radius: 14rpx; background: #fbfaf6; box-shadow: 0 14rpx 28rpx rgba(71, 63, 50, .08); }
.shell-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 28rpx; }
.section-kicker { color: #96998f; font-size: 15rpx; letter-spacing: 2rpx; }
.shell-title { margin-top: 9rpx; color: #252a27; font-size: 34rpx; font-weight: 800; letter-spacing: -.5rpx; }
.secure-tag { display: flex; align-items: center; gap: 7rpx; padding-top: 7rpx; color: #557261; font-size: 18rpx; white-space: nowrap; }
.secure-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #6e9a77; }
.message, .error { display: flex; align-items: flex-start; gap: 10rpx; margin: -6rpx 0 20rpx; padding: 15rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; line-height: 1.5; }
.message { background: #edf5ed; color: #476b50; }
.error { background: #fff0eb; color: #a74431; }
.message-mark, .error-mark { width: 27rpx; height: 27rpx; flex: 0 0 27rpx; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 18rpx; font-weight: 800; }
.message-mark { background: #6e9a77; color: #fff; }
.error-mark { background: #c9573d; color: #fff; }
.mode-switch { display: flex; padding: 5rpx; margin-bottom: 28rpx; border: 1px solid #e0dcd3; border-radius: 9rpx; background: #f1eee7; }
.mode-tab { flex: 1; height: 68rpx; padding: 0; border-radius: 6rpx; background: transparent; color: #858a81; font-size: 23rpx; line-height: 68rpx; }
.mode-tab-active { background: #252a27; color: #fff; font-weight: 700; box-shadow: 0 4rpx 8rpx rgba(37, 42, 39, .14); }
.mode-tab-hover { opacity: .8; }
.field-label { margin-bottom: 10rpx; color: #555b53; font-size: 21rpx; font-weight: 700; }
.code-label { margin-top: 23rpx; }
.input-wrap { position: relative; display: flex; align-items: center; box-sizing: border-box; height: 86rpx; border: 1px solid #d9d7cf; border-radius: 8rpx; background: #fff; transition: border-color .2s, box-shadow .2s; }
.input-wrap:focus-within { border-color: #a96855; box-shadow: 0 0 0 4rpx rgba(201, 87, 61, .1); }
.input { box-sizing: border-box; height: 84rpx; padding: 0 20rpx; background: transparent; color: #252a27; font-size: 26rpx; }
.input-with-prefix { flex: 1; min-width: 0; padding-left: 0; }
.input-prefix { width: 68rpx; flex: 0 0 68rpx; color: #b4afa4; font-family: Georgia, serif; font-size: 25rpx; font-weight: 700; text-align: center; }
.code-prefix { font-size: 19rpx; letter-spacing: 0; }
.lock-prefix { font-size: 20rpx; letter-spacing: 3rpx; }
.code-row { display: flex; gap: 14rpx; }
.code-wrap { flex: 1; min-width: 0; }
.code-input { min-width: 0; }
.send-button { width: 188rpx; height: 86rpx; flex: 0 0 188rpx; padding: 0 8rpx; border: 1px solid #e0a08f; border-radius: 8rpx; background: #fff4ef; color: #b44d37; font-size: 21rpx; line-height: 86rpx; }
.send-button[disabled] { border-color: #e1ded7; background: #f3f1ec; color: #aaa9a3; }
.password-input { padding-right: 85rpx; }
.password-toggle { position: absolute; right: 7rpx; top: 7rpx; width: 72rpx; height: 70rpx; padding: 0; border-radius: 6rpx; background: transparent; color: #a66250; font-size: 20rpx; line-height: 70rpx; }
.primary-button, .wechat-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; height: 88rpx; margin-top: 26rpx; border-radius: 8rpx; font-size: 26rpx; font-weight: 700; line-height: 88rpx; }
.primary-button { background: #252a27; color: #fff; }
.primary-button[disabled] { opacity: .45; }
.button-arrow { margin-left: 19rpx; font-family: Georgia, serif; font-size: 31rpx; font-weight: 400; line-height: 1; }
.primary-hover { background: #3b433e; transform: translateY(1rpx); }
.wechat-button { height: 76rpx; margin-top: 24rpx; border: 1px solid #c9d8ca; background: #f2f8f1; color: #467352; font-size: 23rpx; line-height: 76rpx; }
.wechat-mark { display: inline-flex; align-items: center; justify-content: center; width: 37rpx; height: 37rpx; margin-right: 12rpx; border-radius: 50%; background: #6e9a77; color: #fff; font-size: 18rpx; }
.wechat-hover { background: #e8f2e8; }
.button-hover { opacity: .78; }
.helper-note { margin-top: 16rpx; color: #989b92; font-size: 19rpx; line-height: 1.55; }
.consent-strip { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 5rpx; padding: 30rpx 12rpx 0; color: #777c73; font-size: 20rpx; line-height: 1.8; }
.consent-label { display: inline-flex; align-items: center; }
.consent-label checkbox { transform: scale(.72); margin-right: -5rpx; }
.legal-link { color: #a6513d; font-weight: 600; }
.consent-and { color: #aaa89f; }
.footer-note { display: flex; align-items: center; justify-content: center; gap: 12rpx; padding-top: 22rpx; color: #aaa89f; font-size: 18rpx; }
.footer-rule { width: 34rpx; height: 1px; background: #d2cec3; }
@media (max-width: 340px) {
  .page-inner { padding-left: 26rpx; padding-right: 26rpx; }
  .hero { padding-top: 76rpx; }
  .hero-title { font-size: 58rpx; }
  .login-shell { padding-left: 23rpx; padding-right: 23rpx; }
  .send-button { width: 174rpx; flex-basis: 174rpx; font-size: 19rpx; }
}
