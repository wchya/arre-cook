.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 88rpx 40rpx 56rpx;
  display: flex;
  flex-direction: column;
}

.brand { margin-bottom: 52rpx; }
.mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #e8734a;
  color: #fff;
  font-size: 42rpx;
  line-height: 1;
}
.eyebrow { margin-top: 28rpx; color: #b45a3b; font-size: 19rpx; font-weight: 800; }
.title { margin-top: 10rpx; font-size: 52rpx; line-height: 1.2; font-weight: 800; }
.subtitle { margin-top: 12rpx; color: #73766f; font-size: 25rpx; }
.login-panel { padding: 34rpx 30rpx; border: 1px solid #e9e9e3; border-radius: 12rpx; background: #fff; }
.panel-title { margin-bottom: 28rpx; font-size: 29rpx; font-weight: 700; }
.field-label { margin-bottom: 12rpx; color: #555951; font-size: 23rpx; font-weight: 600; }
.code-label { margin-top: 24rpx; }
.input { box-sizing: border-box; height: 88rpx; padding: 0 24rpx; border: 1px solid #e3e4de; border-radius: 8rpx; background: #fafaf8; font-size: 27rpx; }
.code-row { display: flex; gap: 14rpx; }
.code-input { flex: 1; min-width: 0; }
.send-button { width: 204rpx; height: 88rpx; padding: 0 10rpx; border-radius: 8rpx; background: #fff0eb; color: #bd5939; font-size: 22rpx; line-height: 88rpx; }
.send-button[disabled] { color: #aaa; }
.submit-button, .wechat-button { height: 88rpx; margin-top: 26rpx; border-radius: 8rpx; background: #262a26; color: white; font-size: 27rpx; line-height: 88rpx; font-weight: 700; }
.submit-button[disabled] { opacity: .5; }
.wechat-button { margin-top: 0; background: #208b5b; }
.divider { margin: 26rpx 0; display: flex; align-items: center; gap: 16rpx; color: #9a9d96; font-size: 21rpx; }
.divider::before, .divider::after { content: ""; height: 1px; flex: 1; background: #ecece7; }
.message, .error { margin: -10rpx 0 18rpx; padding: 14rpx 16rpx; border-radius: 7rpx; background: #f0f8f4; color: #347455; font-size: 22rpx; line-height: 1.5; }
.error { background: #fff0ed; color: #b8422b; }
.footnote, .unavailable { margin-top: 18rpx; color: #858981; font-size: 21rpx; line-height: 1.5; }
.privacy { margin-top: auto; padding-top: 44rpx; text-align: center; color: #858981; font-size: 20rpx; }
