page { background: var(--bg); }

.login { position: relative; min-height: 100vh; overflow: hidden; }

/* 暖色光晕背景（对应 Web 登录页三团 blur 光斑） */
.glow { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(90rpx); }
.glow-a { top: -260rpx; left: -200rpx; width: 640rpx; height: 640rpx; background: rgba(232, 115, 74, .26); }
.glow-b { top: 260rpx; right: -200rpx; width: 580rpx; height: 580rpx; background: rgba(245, 215, 110, .32); }
.glow-c { bottom: -160rpx; left: 180rpx; width: 540rpx; height: 540rpx; background: rgba(110, 198, 184, .22); }

.login__inner { position: relative; z-index: 1; display: flex; flex-direction: column; min-height: 100vh; padding: 0 44rpx calc(28rpx + env(safe-area-inset-bottom)); }

/* 品牌区 */
.brand__logo { width: 124rpx; height: 124rpx; margin-bottom: 36rpx; border-radius: 38rpx; box-shadow: 0 28rpx 72rpx rgba(232, 115, 74, .28); }
.brand__title { color: var(--text); font-size: 58rpx; font-weight: 900; line-height: 1.24; letter-spacing: -1rpx; }
.brand__desc { margin-top: 18rpx; color: var(--text2); font-size: 27rpx; line-height: 1.65; }

/* 登录卡片（毛玻璃） */
.panel { margin-top: 44rpx; padding: 32rpx 32rpx 36rpx; border: 1px solid var(--glass-border); border-radius: 56rpx; background: var(--card); box-shadow: 0 48rpx 120rpx rgba(26, 26, 46, .10); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); animation-delay: .06s; }
.modes { margin-bottom: 36rpx; }
.modes .segmented-item { font-size: 25rpx; }
.panel__notice { margin: -8rpx 0 28rpx; }
.pane { animation: popSoft .25s ease both; }
.label-gap { margin-top: 28rpx; }

/* 输入框 */
.field-input--icon { margin-left: 18rpx; }
.field-clear { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; flex-shrink: 0; margin-left: 12rpx; border-radius: 50%; background: var(--text4); }
.code-btn { display: flex; align-items: center; justify-content: center; min-width: 156rpx; height: 64rpx; flex-shrink: 0; margin: 0 -14rpx 0 16rpx; padding: 0 22rpx; border-radius: 22rpx; background: var(--primary-light); color: var(--primary); font-size: 25rpx; font-weight: 700; white-space: nowrap; transition: opacity .2s ease, transform .15s ease; }
.code-btn.is-disabled { opacity: .5; }
.eye { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-right: -12rpx; }

.domains { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.domain-chip { padding: 8rpx 22rpx; font-weight: 600; }

/* 6 位验证码格子 */
.otp { position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14rpx; }
.otp__box { display: flex; align-items: center; justify-content: center; height: 100rpx; border: 3rpx solid var(--border); border-radius: 26rpx; background: var(--bg); transition: border-color .2s ease, background-color .2s ease, box-shadow .2s ease; }
.otp__box.is-filled { border-color: var(--border2); background: var(--card); }
.otp__box.is-active { border-color: var(--primary); background: var(--card); box-shadow: 0 0 0 8rpx rgba(232, 115, 74, .10); }
.otp__digit { color: var(--text); font-size: 42rpx; font-weight: 800; }
.otp__caret { width: 4rpx; height: 44rpx; border-radius: 2rpx; background: var(--primary); animation: caret 1s steps(1) infinite; }
.otp__input { position: absolute; top: 0; left: -3000rpx; width: 200rpx; height: 100rpx; opacity: 0; }
@keyframes caret { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

.submit { margin-top: 36rpx; }

/* 微信登录 */
.pane--wechat { display: flex; flex-direction: column; align-items: center; padding-top: 8rpx; text-align: center; }
.wx-badge { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin-bottom: 20rpx; border-radius: 36rpx; background: linear-gradient(135deg, #E9FAF1 0%, #D5F5E4 100%); box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .9), 0 16rpx 40rpx rgba(7, 193, 96, .14); }
.wx-title { color: var(--text); font-size: 34rpx; font-weight: 800; }
.wx-desc { margin: 8rpx 0 36rpx; color: var(--text3); font-size: 24rpx; }
.wx-alt { display: flex; align-items: center; gap: 4rpx; margin-top: 28rpx; color: var(--primary); font-size: 24rpx; font-weight: 600; }

/* 底部协议 */
.footer { margin-top: auto; padding-top: 40rpx; }
.consent { display: flex; align-items: flex-start; justify-content: center; gap: 14rpx; padding: 16rpx 16rpx; border-radius: 24rpx; transition: background-color .25s ease; }
.consent.is-hint { background: rgba(232, 115, 74, .10); }
.check { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; flex-shrink: 0; margin-top: 3rpx; border: 3rpx solid var(--text4); border-radius: 50%; background: var(--card); transition: background-color .2s ease, border-color .2s ease; }
.consent.is-hint .check { border-color: var(--primary); }
.check.is-on { border-color: var(--primary); background: var(--primary); animation: pop .3s ease; }
.consent__text { color: var(--text2); font-size: 24rpx; line-height: 1.6; }
.link { color: var(--primary); font-weight: 600; }
.safe-note { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 12rpx; color: var(--text3); font-size: 21rpx; }

/* 协议确认弹层 */
.consent-sheet { padding: 8rpx 40rpx 24rpx; }
.consent-sheet__docs { overflow: hidden; margin-bottom: 36rpx; border: 1px solid var(--border); border-radius: 32rpx; }
.doc-row { display: flex; align-items: center; gap: 22rpx; padding: 26rpx 28rpx; transition: background-color .15s ease; }
.doc-row + .doc-row { border-top: 1px solid var(--border); }
.consent-sheet__cancel { margin-top: 12rpx; color: var(--text3); font-weight: 600; }
