<scroll-view class="page" scroll-y="true" enable-flex="true" show-scrollbar="false" enhanced="true">
  <view class="page-inner">
    <view class="topbar">
      <view class="brand">
        <view class="brand-mark">N</view>
        <view>
          <view class="brand-name">NiniMenu</view>
          <view class="brand-subtitle">你的每日餐桌</view>
        </view>
      </view>
      <view class="privacy-badge"><view class="privacy-dot"></view><text>私密保存</text></view>
    </view>

    <view class="intro">
      <view class="intro-label">WELCOME HOME</view>
      <view class="intro-title">今天吃什么，<text>现在就有答案。</text></view>
      <view class="intro-copy">登录后管理你的菜谱、饮食记录和健康计划。</view>
    </view>

    <view class="login-card">
      <view class="card-heading">
        <view>
          <view class="card-eyebrow">ACCOUNT ACCESS</view>
          <view class="card-title">进入你的厨房</view>
        </view>
        <view class="card-index">01 / 01</view>
      </view>

      <view wx:if="{{message}}" class="message" role="status"><view class="status-icon status-success">✓</view><text>{{message}}</text></view>
      <view wx:if="{{error}}" class="error" role="alert"><view class="status-icon status-error">!</view><text>{{error}}</text></view>

      <view class="consent-box">
        <checkbox-group bindchange="onConsentChange"><label class="consent-label"><checkbox value="agreed" checked="{{agreed}}" color="#2f8a61" /><text>我已阅读并同意</text></label></checkbox-group>
        <navigator url="/pages/legal/legal?type=terms" class="legal-link">用户服务协议</navigator><text class="consent-and">和</text><navigator url="/pages/legal/legal?type=privacy" class="legal-link">隐私政策</navigator>
      </view>

      <view wx:if="{{wechatEnabled}}" class="quick-entry">
        <view class="quick-entry-copy">
          <view class="quick-entry-title">微信快捷登录</view>
          <view class="quick-entry-subtitle">已绑定微信账号可直接进入</view>
        </view>
        <button class="wechat-button" hover-class="wechat-hover" loading="{{loading}}" disabled="{{loading || !agreed}}" bindtap="loginWithWechat">
          <view class="wechat-symbol"><view class="wechat-bubble wechat-bubble-main"></view><view class="wechat-bubble wechat-bubble-small"></view></view>
          <text>微信登录</text>
          <text class="button-arrow">→</text>
        </button>
      </view>

      <view wx:if="{{wechatEnabled}}" class="divider"><view class="divider-line"></view><text>或使用其他方式</text><view class="divider-line"></view></view>

      <view wx:if="{{emailEnabled}}" class="mode-switch" role="tablist">
        <button class="mode-tab {{loginMode === 'email' ? 'mode-tab-active' : ''}}" hover-class="mode-tab-hover" data-mode="email" bindtap="switchLoginMode">邮箱验证码</button>
        <button class="mode-tab {{loginMode === 'password' ? 'mode-tab-active' : ''}}" hover-class="mode-tab-hover" data-mode="password" bindtap="switchLoginMode">账号密码</button>
      </view>

      <block wx:if="{{emailEnabled && loginMode === 'email'}}">
        <view class="field-label">QQ / Foxmail 邮箱</view>
        <view class="input-wrap"><text class="input-prefix">@</text><input class="input input-with-prefix" type="text" maxlength="120" value="{{email}}" placeholder="name@qq.com" autocomplete="email" bindinput="onEmailInput" /></view>
        <view class="field-label code-label">邮箱验证码</view>
        <view class="code-row">
          <view class="input-wrap code-wrap"><text class="input-prefix code-prefix">6 位</text><input class="input input-with-prefix code-input" type="number" maxlength="6" value="{{code}}" placeholder="输入验证码" bindinput="onCodeInput" /></view>
          <button class="send-button" hover-class="button-hover" loading="{{sending}}" disabled="{{sending || cooldown > 0 || !agreed}}" bindtap="sendCode">{{cooldown > 0 ? cooldown + ' 秒' : '发送验证码'}}</button>
        </view>
        <button class="primary-button" hover-class="primary-hover" loading="{{loading}}" disabled="{{loading || code.length !== 6 || !agreed}}" bindtap="submitEmail"><text>登录并继续</text><text class="button-arrow">→</text></button>
        <view wx:if="{{!registerOpen}}" class="helper-note">目前暂停新账号注册</view>
        <view wx:elif="{{wechatEnabled}}" class="helper-note">首次使用会将微信绑定到这个邮箱账号</view>
        <view wx:else class="helper-note">验证邮箱后自动创建账号</view>
      </block>

      <block wx:if="{{loginMode === 'password'}}">
        <view class="field-label">账号</view>
        <view class="input-wrap"><text class="input-prefix">ID</text><input class="input input-with-prefix" type="text" maxlength="120" value="{{account}}" placeholder="邮箱或用户名" autocomplete="username" bindinput="onAccountInput" /></view>
        <view class="field-label code-label">密码</view>
        <view class="input-wrap"><text class="input-prefix lock-prefix">••</text><input class="input input-with-prefix password-input" type="{{passwordVisible ? 'text' : 'password'}}" maxlength="128" value="{{password}}" placeholder="输入密码" autocomplete="current-password" bindinput="onPasswordInput" /><button class="password-toggle" hover-class="button-hover" bindtap="togglePasswordVisibility">{{passwordVisible ? '隐藏' : '显示'}}</button></view>
        <button class="primary-button" hover-class="primary-hover" loading="{{loading}}" disabled="{{loading || !account || !password || !agreed}}" bindtap="submitPassword"><text>账号密码登录</text><text class="button-arrow">→</text></button>
        <view class="helper-note">提审账号也可以从这里进入完整功能。</view>
      </block>

    </view>

    <view class="footer-note"><view class="footer-rule"></view><text>你的账号数据仅对你可见</text><view class="footer-rule"></view></view>
  </view>
</scroll-view>
