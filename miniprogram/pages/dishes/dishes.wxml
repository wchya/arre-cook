<view class="screen">
  <nav-bar icon="utensils-crossed" title="菜品" subtitle="选菜加餐，一键搞定" theme="plain">
    <view class="nav-add" hover-class="tap-active" bindtap="createDish" aria-role="button" aria-label="新建私房菜">
      <icon name="plus" size="34" stroke="2.4" color="primary" />
    </view>
  </nav-bar>

  <view class="body">
    <!-- 左侧分类栏 -->
    <scroll-view class="side" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{categories}}" wx:key="name" class="side__item {{(category === item.name && !(grouped && highlight && item.name === '全部')) || (grouped && highlight === item.name) ? 'is-active' : ''}}" data-name="{{item.name}}" bindtap="selectCategory">
        <text class="side__name">{{item.name}}</text>
        <text class="side__count">{{item.count}}道</text>
      </view>
      <view class="side__space"></view>
    </scroll-view>

    <view class="main">
      <!-- 搜索 + 范围 -->
      <view class="search-row">
        <view class="search {{searchFocus ? 'is-focus' : ''}}">
          <icon name="search" size="28" stroke="2.4" color="text3" />
          <input class="search__input" value="{{keyword}}" placeholder="搜索菜品、配料、标签" placeholder-class="placeholder search__ph" confirm-type="search" bindinput="onSearchInput" bindfocus="onSearchFocus" bindblur="onSearchBlur" />
          <view wx:if="{{keyword}}" class="search__clear" catchtap="clearSearch" aria-role="button" aria-label="清空搜索"><icon name="x" size="20" stroke="3" color="white" /></view>
        </view>
        <view class="scope-btn {{scope ? 'is-active' : ''}}" hover-class="tap-active" bindtap="chooseScope" aria-role="button" aria-label="选择菜谱范围">
          <text>{{scopeLabel}}</text>
          <icon name="chevron-down" size="22" stroke="2.6" color="{{scope ? 'primary' : 'text3'}}" />
        </view>
      </view>

      <!-- 口味筛选 -->
      <scroll-view class="tastes" scroll-x enhanced show-scrollbar="{{false}}">
        <view wx:for="{{tastes}}" wx:key="*this" class="taste {{taste === item ? 'is-active' : ''}}" data-taste="{{item}}" bindtap="selectTaste">{{item}}</view>
      </scroll-view>

      <!-- 菜品列表 -->
      <scroll-view
        class="list"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        scroll-top="{{scrollTop}}"
        scroll-into-view="{{scrollIntoView}}"
        lower-threshold="240"
        refresher-enabled
        refresher-background="#FAFAF8"
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
        bindscrolltolower="loadMore"
        bindscroll="onListScroll"
      >
        <view wx:if="{{loading}}" class="skeleton-list">
          <view wx:for="{{[1, 2, 3, 4, 5, 6]}}" wx:key="*this" class="sk-row">
            <view class="skeleton sk-thumb"></view>
            <view class="flex-1"><view class="skeleton sk-line"></view><view class="skeleton sk-line short"></view><view class="skeleton sk-line tiny"></view></view>
          </view>
        </view>

        <view wx:elif="{{error}}" class="list-state">
          <empty emoji="📡" title="加载失败" desc="{{error}}" compact>
            <view class="btn btn-soft btn-sm" hover-class="tap-active" bindtap="reload">重新加载</view>
          </empty>
        </view>

        <view wx:elif="{{!groups.length}}" class="list-state">
          <empty emoji="🍽" title="没有找到菜品" desc="{{keyword ? '换个关键词试试？' : scope === 'mine' ? '还没有私房菜，点右上角“＋”新建一道' : '这个分类暂时没有菜品'}}" compact>
            <view wx:if="{{scope === 'mine'}}" class="btn btn-primary btn-sm" hover-class="tap-active" bindtap="createDish">新建私房菜</view>
          </empty>
        </view>

        <block wx:else>
          <view wx:for="{{groups}}" wx:for-item="group" wx:key="anchor" id="{{group.anchor}}" class="group">
            <view wx:if="{{grouped}}" class="group__head"><view class="group__bar"></view><text>{{group.name}}</text><text class="group__count">{{group.count}}道</text></view>
            <view wx:elif="{{keyword}}" class="group__head group__head--result"><text>“{{keyword}}” 共 {{total}} 道</text></view>

            <view wx:for="{{group.items}}" wx:key="id" class="row-dish" hover-class="row-dish--press" hover-stay-time="60">
              <view class="thumb" data-id="{{item.id}}" bindtap="openDish">
                <dish-image src="{{item.cover}}" emoji="{{item.emoji}}" emoji-size="52" />
              </view>
              <view class="info">
                <view class="info__top" data-id="{{item.id}}" bindtap="openDish">
                  <text class="info__name">{{item.name}}</text>
                  <text wx:if="{{item.isPrivate}}" class="chip chip-sm chip-purple private-tag">私房</text>
                </view>
                <view class="info__meta" data-id="{{item.id}}" bindtap="openDish">
                  <text>{{item.category}}</text>
                  <block wx:if="{{item.cookTime}}"><view class="dot"></view><text>{{item.cookTime}}分钟</text></block>
                  <view class="dot"></view><text class="c-{{item.diffTone}}">{{item.diffLabel}}</text>
                  <block wx:if="{{item.taste}}"><view class="dot"></view><text class="truncate">{{item.taste}}</text></block>
                </view>
                <view class="info__actions">
                  <view class="meal-toggle {{lunchIds[item.id] ? 'is-lunch' : ''}} {{pending['lunch' + item.id] ? 'is-pending' : ''}}" data-id="{{item.id}}" data-meal="lunch" bindtap="toggleMeal" hover-class="tap-active" hover-stay-time="60">
                    <icon name="{{lunchIds[item.id] ? 'minus' : 'plus'}}" size="18" stroke="3" color="{{lunchIds[item.id] ? 'white' : 'text2'}}" />
                    <text>🍳 午餐</text>
                  </view>
                  <view class="meal-toggle {{dinnerIds[item.id] ? 'is-dinner' : ''}} {{pending['dinner' + item.id] ? 'is-pending' : ''}}" data-id="{{item.id}}" data-meal="dinner" bindtap="toggleMeal" hover-class="tap-active" hover-stay-time="60">
                    <icon name="{{dinnerIds[item.id] ? 'minus' : 'plus'}}" size="18" stroke="3" color="{{dinnerIds[item.id] ? 'white' : 'text2'}}" />
                    <text>🍲 晚餐</text>
                  </view>
                  <view class="fav {{item.favorite ? 'is-on anim-heartbeat' : ''}}" data-id="{{item.id}}" bindtap="toggleFav" aria-role="button" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}">
                    <icon name="heart" size="32" stroke="2.2" color="{{item.favorite ? 'primary' : 'text4'}}" fill="{{item.favorite}}" />
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{loadingMore}}" class="loading-more"><view class="spinner spinner-dark inline-spinner"></view>加载中…</view>
          <view wx:elif="{{hasMore}}" class="loading-more" bindtap="loadMore">上滑加载更多</view>
          <view wx:else class="loading-more">共 {{loaded}} 道菜</view>
        </block>

        <view class="{{lunchCount + dinnerCount > 0 ? 'list-space-bar' : 'list-space'}}"></view>
      </scroll-view>
    </view>
  </view>

  <!-- 今日菜单悬浮条 -->
  <view wx:if="{{lunchCount + dinnerCount > 0}}" class="today-bar anim-fade-up">
    <view class="today-bar__icon">
      <icon name="chef-hat" size="42" stroke="2.2" color="primary" />
      <view class="today-bar__badge">{{lunchCount + dinnerCount}}</view>
    </view>
    <view class="today-bar__text">
      <text wx:if="{{lunchCount}}" class="c-primary bold">🍳午餐{{lunchCount}}道</text>
      <text wx:if="{{lunchCount && dinnerCount}}" class="c-text3"> · </text>
      <text wx:if="{{dinnerCount}}" class="c-mint bold">🍲晚餐{{dinnerCount}}道</text>
    </view>
    <view class="btn btn-sm btn-primary" hover-class="tap-active" bindtap="openToday">今日菜单</view>
  </view>

  <sheet show="{{todayOpen}}" title="📋 今日菜单" bind:close="closeToday">
    <view class="today">
      <view class="grid-3 today__stats">
        <view class="today__stat"><view class="today__label">菜品</view><view class="today__value">{{lunchCount + dinnerCount}} 道</view></view>
        <view class="today__stat"><view class="today__value">午餐 {{lunchCount}} 道</view><view class="today__label">约用时 {{lunchMinutes ? lunchMinutes + 'm' : '-'}}</view></view>
        <view class="today__stat"><view class="today__value">晚餐 {{dinnerCount}} 道</view><view class="today__label">约用时 {{dinnerMinutes ? dinnerMinutes + 'm' : '-'}}</view></view>
      </view>

      <view wx:if="{{todayLunch.length}}" class="today__group">
        <view class="today__title c-primary">🍳 午餐</view>
        <view wx:for="{{todayLunch}}" wx:key="id" class="today__item" hover-class="tap-active" data-id="{{item.dishId}}" bindtap="openTodayDish">
          <view class="today__thumb"><dish-image src="{{item.cover}}" emoji="{{item.emoji}}" emoji-size="40" /></view>
          <view class="flex-1"><view class="today__name">{{item.name}}</view><view wx:if="{{item.meta}}" class="today__meta">{{item.meta}}</view></view>
          <view class="today__del" data-id="{{item.id}}" catchtap="removeToday" aria-role="button" aria-label="移除"><icon name="trash-2" size="28" stroke="2.2" color="red" /></view>
        </view>
      </view>
      <view wx:if="{{todayDinner.length}}" class="today__group">
        <view class="today__title c-mint">🍲 晚餐</view>
        <view wx:for="{{todayDinner}}" wx:key="id" class="today__item" hover-class="tap-active" data-id="{{item.dishId}}" bindtap="openTodayDish">
          <view class="today__thumb"><dish-image src="{{item.cover}}" emoji="{{item.emoji}}" emoji-size="40" /></view>
          <view class="flex-1"><view class="today__name">{{item.name}}</view><view wx:if="{{item.meta}}" class="today__meta">{{item.meta}}</view></view>
          <view class="today__del" data-id="{{item.id}}" catchtap="removeToday" aria-role="button" aria-label="移除"><icon name="trash-2" size="28" stroke="2.2" color="red" /></view>
        </view>
      </view>
    </view>
    <view slot="footer" class="sheet-footer">
      <view class="btn btn-block btn-primary" hover-class="tap-active" bindtap="closeToday">继续选菜</view>
    </view>
  </sheet>
</view>
