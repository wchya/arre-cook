page { height: 100%; overflow: hidden; background: var(--bg); }

.nav-add { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border: 1px solid rgba(232, 115, 74, .15); border-radius: 50%; background: var(--primary-light); }

.body { display: flex; flex: 1; min-height: 0; }

/* 左侧分类 */
.side { width: 152rpx; height: 100%; flex-shrink: 0; border-right: 1px solid var(--border); background: var(--card); }
.side__item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24rpx 8rpx; color: var(--text2); text-align: center; transition: background-color .2s ease, color .2s ease; }
.side__name { font-size: 24rpx; font-weight: 500; line-height: 1.3; }
.side__count { margin-top: 2rpx; color: var(--text3); font-size: 20rpx; }
.side__item.is-active { background: var(--bg); color: var(--primary); }
.side__item.is-active .side__name { font-weight: 700; }
.side__item.is-active::before { position: absolute; top: 50%; left: 0; width: 6rpx; height: 40rpx; border-radius: 0 999rpx 999rpx 0; background: var(--primary); content: ""; transform: translateY(-50%); }
.side__space { height: calc(160rpx + env(safe-area-inset-bottom)); }

/* 右侧 */
.main { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.search-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 24rpx 16rpx; }
.search { display: flex; flex: 1; align-items: center; gap: 12rpx; height: 72rpx; padding: 0 24rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--card); transition: border-color .2s ease, box-shadow .2s ease; }
.search.is-focus { border-color: var(--primary); box-shadow: 0 0 0 6rpx rgba(232, 115, 74, .12); }
.search__input { flex: 1; min-width: 0; height: 72rpx; color: var(--text); font-size: 26rpx; }
.search__ph { font-size: 26rpx; }
.search__clear { display: flex; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; flex-shrink: 0; border-radius: 50%; background: var(--text4); }
.scope-btn { display: flex; align-items: center; gap: 4rpx; height: 72rpx; padding: 0 20rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--card); color: var(--text2); font-size: 24rpx; font-weight: 600; white-space: nowrap; }
.scope-btn.is-active { border-color: rgba(232, 115, 74, .3); background: var(--primary-light); color: var(--primary); }

.tastes { width: 100%; padding: 0 24rpx 16rpx; white-space: nowrap; }
.taste { display: inline-block; margin-right: 12rpx; padding: 8rpx 24rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--card); color: var(--text2); font-size: 22rpx; font-weight: 500; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
.taste.is-active { border-color: var(--pink); background: var(--pink); color: #fff; }

.list { flex: 1; height: 0; padding: 0 24rpx; }
.list-space { height: calc(160rpx + env(safe-area-inset-bottom)); }
.list-space-bar { height: calc(280rpx + env(safe-area-inset-bottom)); }
.list-state { padding-top: 40rpx; }

.group__head { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; gap: 12rpx; padding: 16rpx 4rpx; background: var(--bg); color: var(--text2); font-size: 26rpx; font-weight: 700; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
.group__head--result { font-weight: 600; }
.group__bar { width: 8rpx; height: 30rpx; border-radius: 999rpx; background: var(--primary); }
.group__count { color: var(--text3); font-size: 22rpx; font-weight: 400; }

/* 菜品行（对应 Web DishRow） */
.row-dish { display: flex; align-items: center; gap: 24rpx; margin: 0 -8rpx; padding: 18rpx 8rpx; border-radius: 24rpx; transition: background-color .15s ease; }
.row-dish--press { background: var(--card); }
.thumb { width: 144rpx; height: 144rpx; flex-shrink: 0; overflow: hidden; border-radius: 24rpx; }
.info { flex: 1; min-width: 0; }
.info__top { display: flex; align-items: center; gap: 10rpx; margin-bottom: 4rpx; }
.info__name { overflow: hidden; color: var(--text); font-size: 28rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.private-tag { flex-shrink: 0; }
.info__meta { display: flex; align-items: center; gap: 10rpx; overflow: hidden; margin-bottom: 14rpx; color: var(--text2); font-size: 22rpx; white-space: nowrap; }
.dot { width: 6rpx; height: 6rpx; flex-shrink: 0; border-radius: 50%; background: var(--text3); }
.info__actions { display: flex; align-items: center; gap: 12rpx; }
.meal-toggle { display: flex; align-items: center; gap: 6rpx; height: 48rpx; padding: 0 18rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--card); color: var(--text2); font-size: 22rpx; font-weight: 600; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
.meal-toggle.is-lunch { border-color: var(--primary); background: var(--primary); color: #fff; }
.meal-toggle.is-dinner { border-color: var(--mint); background: var(--mint); color: #fff; }
.meal-toggle.is-pending { opacity: .5; }
.fav { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-left: auto; }

.inline-spinner { display: inline-block; width: 24rpx; height: 24rpx; margin-right: 10rpx; vertical-align: -4rpx; }

/* 骨架 */
.skeleton-list { padding-top: 8rpx; }
.sk-row { display: flex; gap: 24rpx; padding: 18rpx 0; }
.sk-thumb { width: 144rpx; height: 144rpx; flex-shrink: 0; border-radius: 24rpx; }
.sk-line { width: 75%; height: 28rpx; margin: 12rpx 0; border-radius: 8rpx; }
.sk-line.short { width: 50%; height: 20rpx; }
.sk-line.tiny { width: 60%; height: 44rpx; border-radius: 999rpx; }

/* 今日菜单悬浮条 */
.today-bar { position: fixed; right: 24rpx; bottom: calc(144rpx + env(safe-area-inset-bottom)); left: 24rpx; z-index: 90; display: flex; align-items: center; gap: 20rpx; padding: 18rpx 20rpx 18rpx 28rpx; border: 1px solid var(--border); border-radius: 999rpx; background: var(--card); box-shadow: 0 16rpx 48rpx rgba(26, 26, 46, .12); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); }
.today-bar__icon { position: relative; }
.today-bar__badge { position: absolute; top: -12rpx; right: -18rpx; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 999rpx; background: var(--primary); color: #fff; font-size: 20rpx; font-weight: 700; line-height: 32rpx; text-align: center; }
.today-bar__text { flex: 1; min-width: 0; font-size: 26rpx; }

/* 今日菜单弹层 */
.today { padding: 0 40rpx 16rpx; }
.today__stats { margin-bottom: 32rpx; }
.today__stat { padding: 20rpx 24rpx; border-radius: 32rpx; background: var(--bg); }
.today__label { color: var(--text3); font-size: 22rpx; font-weight: 600; }
.today__value { color: var(--text); font-size: 30rpx; font-weight: 800; line-height: 1.4; }
.today__group { margin-bottom: 36rpx; }
.today__title { margin-bottom: 18rpx; font-size: 26rpx; font-weight: 700; }
.today__item { display: flex; align-items: center; gap: 24rpx; margin-bottom: 16rpx; padding: 20rpx; border-radius: 24rpx; background: var(--bg); }
.today__thumb { width: 104rpx; height: 104rpx; flex-shrink: 0; overflow: hidden; border-radius: 16rpx; }
.today__name { overflow: hidden; color: var(--text); font-size: 28rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.today__meta { margin-top: 4rpx; color: var(--text2); font-size: 22rpx; }
.today__del { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; flex-shrink: 0; border-radius: 50%; background: var(--red-light); }
.sheet-footer { padding: 20rpx 40rpx 12rpx; border-top: 1px solid var(--border); }
