.de-body { padding-bottom: 200rpx; }
.de-sec { margin-bottom: 24rpx; padding: 28rpx 32rpx; }
.de-sec__title { display: flex; align-items: center; gap: 10rpx; margin-bottom: 24rpx; color: var(--primary); font-size: 24rpx; font-weight: 800; letter-spacing: 1rpx; }
.de-field + .de-field { margin-top: 28rpx; }

.de-cover { position: relative; display: block; width: 100%; height: 340rpx; overflow: hidden; border: 3rpx dashed var(--border2); border-radius: 28rpx; background: var(--bg); }
.de-cover__img { width: 100%; height: 100%; }
.de-cover__ph { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 12rpx; color: var(--text3); font-size: 24rpx; }
.de-cover__badge { position: absolute; right: 16rpx; bottom: 16rpx; display: flex; align-items: center; gap: 6rpx; padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(0, 0, 0, .5); color: #fff; font-size: 22rpx; }

.de-thumbs { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.de-thumb { position: relative; width: 148rpx; height: 148rpx; overflow: hidden; border-radius: 20rpx; background: var(--bg); }
.de-thumb__img { width: 100%; height: 100%; }
.de-thumb__del { position: absolute; top: 0; right: 0; display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-bottom-left-radius: 16rpx; background: rgba(0, 0, 0, .55); }
.de-add { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 148rpx; height: 148rpx; gap: 6rpx; border: 3rpx dashed var(--border2); border-radius: 20rpx; color: var(--text3); font-size: 22rpx; }

.de-seg { margin-top: 4rpx; }
.de-num { display: inline-flex; align-items: center; height: 88rpx; padding: 0 8rpx; border: 3rpx solid var(--border); border-radius: 999rpx; background: var(--bg); }
.de-num__btn { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; }
.de-num__val { min-width: 88rpx; text-align: center; color: var(--text); font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.de-num__unit { padding-right: 20rpx; color: var(--text3); font-size: 24rpx; }

.de-save { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: flex; gap: 16rpx; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1px solid var(--border); background: var(--card); backdrop-filter: blur(14rpx); }

/* 视频链接预览卡片 */
.de-vp { display: flex; gap: 20rpx; margin-top: 20rpx; padding: 16rpx; border: 1px solid var(--border); border-radius: 24rpx; background: var(--bg); }
.de-vp--loading { align-items: center; justify-content: center; gap: 12rpx; color: var(--text3); font-size: 24rpx; }
.de-vp__cover { flex: none; width: 220rpx; height: 140rpx; border-radius: 16rpx; background: var(--border); }
.de-vp__cover--ph { display: flex; align-items: center; justify-content: center; }
.de-vp__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.de-vp__badges { display: flex; align-items: center; gap: 10rpx; }
.de-vp__dur { color: var(--text3); font-size: 22rpx; font-variant-numeric: tabular-nums; }
.de-vp__title { color: var(--text); font-size: 26rpx; font-weight: 700; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.de-vp__author { color: var(--text3); font-size: 22rpx; }
.de-vp__hint { display: flex; align-items: center; gap: 6rpx; margin-top: auto; color: var(--text3); font-size: 22rpx; }

/* 共享范围开关 */
.de-share { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; border: 1px solid var(--border); border-radius: 24rpx; background: var(--bg); transition: border-color .2s, background .2s; }
.de-share.is-on { border-color: var(--primary); background: var(--primary-soft, rgba(232, 115, 74, .08)); }
.de-share.is-note { background: var(--bg); }
.de-share__main { flex: 1; min-width: 0; }
.de-share__name { color: var(--text); font-size: 28rpx; font-weight: 700; }
.de-share__desc { margin-top: 6rpx; color: var(--text3); font-size: 24rpx; }
.de-switch { flex: none; width: 88rpx; height: 52rpx; padding: 4rpx; border-radius: 999rpx; background: var(--border2); transition: background .2s; }
.de-switch.is-on { background: var(--primary); }
.de-switch__dot { width: 44rpx; height: 44rpx; border-radius: 50%; background: #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.2); transition: transform .2s; }
.de-switch.is-on .de-switch__dot { transform: translateX(36rpx); }
