<nav-bar title="{{isNew ? '新建私房菜' : '编辑菜品'}}" subtitle="{{alreadyFamily || shareFamily ? '家庭成员可见' : '仅自己可见'}}" icon="chef-hat" />

<request-state wx:if="{{loading || error}}" error="{{error}}" retrying="{{loading}}" bind:retry="initialize" />
<view wx:elif="{{recovery}}" class="content">
  <view class="draft-notice">
    <view class="draft-title">有一份未完成的草稿</view>
    <view class="draft-desc">保存于 {{recovery.time}}。恢复后可继续编辑，保存才会更新菜谱。</view>
    <button class="btn btn-primary mt-24" bindtap="resumeDraft">继续编辑草稿</button>
    <button class="btn btn-ghost mt-16" bindtap="discardDraft">丢弃旧草稿</button>
  </view>
</view>
<view wx:else class="content anim-fade-up de-body">
  <view class="draft-status">{{draftStatus}}</view>
  <view class="card de-sec">
    <view class="de-sec__title"><icon name="notebook-pen" size="26" stroke="2.4" color="primary" /><text>基本信息</text></view>

    <view class="de-field">
      <view class="field-label">菜品名称 *</view>
      <view class="field {{focusKey === 'name' ? 'is-focus' : ''}}">
        <input class="field-input" value="{{name}}" maxlength="100" placeholder="如：番茄炒蛋" placeholder-class="placeholder" data-key="name" bindfocus="onFocus" bindblur="onBlur" bindinput="onName" />
      </view>
    </view>

    <view class="de-field">
      <view class="field-label">分类</view>
      <view class="chips">
        <view wx:for="{{categories}}" wx:key="*this" class="chip {{category === item ? 'chip-solid' : 'chip-ghost'}}" hover-class="tap-active" data-value="{{item}}" bindtap="chooseCategory">{{item}}</view>
      </view>
    </view>

    <view class="de-field">
      <view class="field-label">适合餐次</view>
      <view class="segmented de-seg">
        <view class="segmented-thumb" style="{{mealStyle}}"></view>
        <view wx:for="{{meals}}" wx:key="value" class="segmented-item {{mealType === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" bindtap="chooseMeal">{{item.label}}</view>
      </view>
    </view>

    <view class="de-field">
      <view class="field-label">难度</view>
      <view class="segmented de-seg">
        <view class="segmented-thumb" style="{{diffStyle}}"></view>
        <view wx:for="{{diffs}}" wx:key="value" class="segmented-item {{difficulty === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" bindtap="chooseDiff">{{item.label}}</view>
      </view>
    </view>

    <view class="de-field">
      <view class="field-label">口味（可多选）</view>
      <tag-input value="{{tasteList}}" suggestions="{{tastes}}" tone="primary" placeholder="添加口味，回车确认" bind:change="onTasteChange" />
    </view>

    <view class="de-field de-numbers">
      <view class="flex-1">
        <view class="field-label">烹饪时间</view>
        <view class="de-num">
          <view class="de-num__btn" hover-class="tap-active" data-delta="-5" bindtap="stepCook"><icon name="minus" size="28" stroke="2.6" color="text2" /></view>
          <text class="de-num__val">{{cookTime}}</text>
          <view class="de-num__btn" hover-class="tap-active" data-delta="5" bindtap="stepCook"><icon name="plus" size="28" stroke="2.6" color="text2" /></view>
          <text class="de-num__unit">分钟</text>
        </view>
        <view class="field-hint">未注明时保留 0，确认后再填写</view>
      </view>
      <view class="flex-1">
        <view class="field-label">排序权重</view>
        <view class="de-num">
          <view class="de-num__btn" hover-class="tap-active" data-delta="-1" bindtap="stepSort"><icon name="minus" size="28" stroke="2.6" color="text2" /></view>
          <text class="de-num__val">{{sortOrder}}</text>
          <view class="de-num__btn" hover-class="tap-active" data-delta="1" bindtap="stepSort"><icon name="plus" size="28" stroke="2.6" color="text2" /></view>
        </view>
      </view>
    </view>
  </view>

  <view class="card de-sec">
    <view class="de-sec__title"><icon name="image" size="26" stroke="2.4" color="primary" /><text>图片与视频</text></view>
    <view class="de-field">
      <view class="field-label">主图</view>
      <view class="de-cover" hover-class="tap-fade" bindtap="pickCover">
        <image wx:if="{{cover}}" class="de-cover__img" src="{{cover}}" mode="aspectFill" webp />
        <view wx:else class="de-cover__ph"><icon name="camera" size="52" stroke="2" color="text3" /><text>点击上传主图</text></view>
        <view class="de-cover__badge">
          <view wx:if="{{uploadingCover}}" class="spinner spinner-dark"></view>
          <block wx:else><icon name="camera" size="22" stroke="2.4" color="white" /><text>{{cover ? '更换' : '上传'}}</text></block>
        </view>
      </view>
    </view>
    <view class="de-field">
      <view class="field-label">更多图片</view>
      <view class="de-thumbs">
        <view wx:for="{{imageThumbs}}" wx:key="*this" class="de-thumb">
          <image class="de-thumb__img" src="{{item}}" mode="aspectFill" webp />
          <view class="de-thumb__del" hover-class="tap-active" hover-stay-time="60" catchtap="removeImage" data-index="{{index}}"><icon name="x" size="24" stroke="2.6" color="white" /></view>
        </view>
        <view class="de-add" hover-class="tap-active" bindtap="pickExtra">
          <view wx:if="{{uploadingExtra}}" class="spinner"></view>
          <block wx:else><icon name="plus" size="34" stroke="2.4" color="text3" /><text>添加</text></block>
        </view>
      </view>
    </view>
    <view class="de-field">
      <view class="field-label">教程视频链接</view>
      <view class="field {{focusKey === 'video' ? 'is-focus' : ''}}">
        <input class="field-input" maxlength="2048" value="{{videoUrl}}" placeholder="B站 / 抖音链接" placeholder-class="placeholder" data-key="video" bindfocus="onFocus" bindblur="onBlur" bindinput="onVideo" />
      </view>
      <view wx:if="{{videoChecking}}" class="de-vp de-vp--loading">
        <view class="spinner"></view><text>正在获取链接预览…</text>
      </view>
      <view wx:elif="{{videoMeta}}" class="de-vp" hover-class="tap-fade" bindtap="openVideoLink">
        <image wx:if="{{videoMeta.cover}}" class="de-vp__cover" src="{{videoMeta.cover}}" mode="aspectFill" binderror="onCoverError" webp />
        <view wx:else class="de-vp__cover de-vp__cover--ph"><icon name="video" size="44" stroke="2" color="text3" /></view>
        <view class="de-vp__body">
          <view class="de-vp__badges">
            <text class="chip chip-sm chip-primary">{{videoMeta.platformName}}</text>
            <text wx:if="{{videoMeta.supported}}" class="chip chip-sm chip-mint">平台视频</text>
            <text wx:else class="chip chip-sm chip-pink">暂不支持</text>
            <text wx:if="{{videoMeta.duration}}" class="de-vp__dur">{{videoMeta.duration}}</text>
          </view>
          <view class="de-vp__title">{{videoMeta.title || '已识别链接'}}</view>
          <view wx:if="{{videoMeta.author}}" class="de-vp__author">{{videoMeta.author}}</view>
          <view class="de-vp__hint"><icon name="external-link" size="22" stroke="2.4" color="text3" /><text>{{videoMeta.supported ? videoMeta.actionLabel : '目前仅支持抖音和哔哩哔哩'}}</text></view>
        </view>
      </view>
      <view class="field-hint">仅支持抖音 / 哔哩哔哩，粘贴后自动识别平台、标题与封面</view>
      <view class="de-import">
        <view class="de-import__title">从视频提炼做法</view>
        <view class="field-hint">支持 10 分钟以内的公开视频。{{videoASREnabled ? '优先读取字幕，无字幕时识别视频语音，再整理做法。' : '优先读取公开字幕并交给 AI 提炼；无法读取时，可粘贴字幕或文稿。'}}仅填入空白项，核对后再保存。</view>
        <button class="de-import__link" disabled="{{videoImportBusy}}" bindtap="toggleVideoTranscript">{{showVideoTranscript ? '返回视频自动读取' : '粘贴字幕或视频文稿'}}</button>
        <view wx:if="{{showVideoTranscript}}">
          <view class="field-label">字幕 / 视频文稿</view>
          <textarea class="field-textarea" aria-label="字幕 / 视频文稿" value="{{videoTranscript}}" maxlength="8000" disabled="{{videoImportBusy}}" placeholder="粘贴这道菜的完整做法，不必整理格式（20–8000 字）" placeholder-class="placeholder" bindinput="onVideoTranscript" />
          <view class="field-hint">{{videoTranscript.length}} / 8000 字 · 文稿将用于 AI 提炼</view>
        </view>
        <view wx:if="{{videoStatusError}}" class="field-hint">{{videoStatusError}}<button class="de-import__link" bindtap="loadVideoImportStatus">重新加载</button></view>
        <view wx:elif="{{!videoStatusLoading && !videoImportAvailable}}" class="field-hint">管理员尚未启用 AI 提炼，可以继续手动填写菜谱。</view>
        <view wx:if="{{videoQuotaText}}" class="field-hint">{{videoQuotaText}}</view>
        <view class="de-import__actions">
          <button class="btn btn-primary" disabled="{{videoImportBusy || saving || !videoUrl || !videoImportAvailable || videoQuotaBlocked}}" bindtap="extractVideo"><view wx:if="{{videoImportBusy}}" class="spinner"></view>{{videoImportBusy ? '提炼中…' : showVideoTranscript ? '从字幕提炼' : '从视频提炼'}}</button>
          <button wx:if="{{videoImportBusy}}" class="btn btn-ghost" bindtap="cancelVideoImport">取消</button>
        </view>
        <view wx:if="{{videoImportBusy}}" class="field-hint" aria-role="status">{{videoImportProgress}}</view>
        <view wx:if="{{videoImportError}}" class="de-import__error" aria-role="alert">{{videoImportError}}</view>
        <view wx:if="{{videoResult}}" class="de-import__result">
          <view class="de-import__title">{{videoResult.count ? '已填入 ' + videoResult.count + ' 项空白内容，核对后保存。' : '已提炼完成。当前字段已有内容，可展开结果核对。'}}</view>
          <view class="field-hint">依据：{{videoResult.source}}。视频未注明的信息请自行补充。</view>
          <button class="de-import__link" bindtap="toggleVideoResult">{{videoResultExpanded ? '收起提炼结果' : '查看提炼结果与字幕依据'}}</button>
          <view wx:if="{{videoResultExpanded}}">
            <view class="field-label">{{videoResult.name}}</view>
            <view class="field-hint">食材：{{videoResult.ingredients}}</view>
            <view wx:for="{{videoResult.steps}}" wx:key="index" class="de-import__step"><view>{{index + 1}}. {{item.text}}</view><view class="field-hint">原句：{{item.evidence}}</view></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{canShareFamily}}" class="card de-sec">
    <view class="de-sec__title"><icon name="users-round" size="26" stroke="2.4" color="primary" /><text>共享范围</text></view>
    <view class="de-share {{shareFamily ? 'is-on' : ''}}" hover-class="tap-active" bindtap="toggleShareFamily">
      <view class="de-share__main">
        <view class="de-share__name">分享到「{{familyName}}」</view>
        <view class="de-share__desc">{{shareFamily ? '家庭成员都能看到并一起管理这道菜' : '默认仅自己可见的私房菜'}}</view>
      </view>
      <view class="de-switch {{shareFamily ? 'is-on' : ''}}"><view class="de-switch__dot"></view></view>
    </view>
  </view>
  <view wx:elif="{{alreadyFamily}}" class="card de-sec">
    <view class="de-share is-note">
      <icon name="users-round" size="30" stroke="2.4" color="primary" />
      <view class="de-share__main"><view class="de-share__name">已共享给家庭</view><view class="de-share__desc">家庭成员都能看到这道菜</view></view>
    </view>
  </view>

  <view class="card de-sec">
    <view class="de-sec__title"><icon name="soup" size="26" stroke="2.4" color="primary" /><text>食材与步骤</text></view>
    <view class="de-field">
      <view class="field-label">配料清单</view>
      <textarea maxlength="100000" class="field-textarea {{focusKey === 'ing' ? 'is-focus' : ''}}" value="{{ingredientsText}}" placeholder="每行一样，如：番茄 2个" placeholder-class="placeholder" data-key="ing" bindfocus="onFocus" bindblur="onBlur" bindinput="onIngredients" auto-height />
      <view class="field-hint">每行「名称 数量」，最后一段作为数量</view>
    </view>
    <view class="de-field">
      <view class="field-label">调料清单</view>
      <textarea maxlength="100000" class="field-textarea {{focusKey === 'sea' ? 'is-focus' : ''}}" value="{{seasoningsText}}" placeholder="如：盐 1茶匙" placeholder-class="placeholder" data-key="sea" bindfocus="onFocus" bindblur="onBlur" bindinput="onSeasonings" auto-height />
    </view>
    <view class="de-field">
      <view class="field-label">制作步骤</view>
      <textarea maxlength="100000" class="field-textarea {{focusKey === 'step' ? 'is-focus' : ''}}" value="{{stepsText}}" placeholder="每行一步，可写 (3分钟) 标注时间" placeholder-class="placeholder" data-key="step" bindfocus="onFocus" bindblur="onBlur" bindinput="onSteps" auto-height />
    </view>
  </view>

  <view class="card de-sec">
    <view class="de-sec__title"><icon name="tag" size="26" stroke="2.4" color="primary" /><text>标签与备注</text></view>
    <view class="de-field">
      <view class="field-label">标签</view>
      <tag-input value="{{tags}}" tone="primary" placeholder="添加标签，回车确认" bind:change="onTagsChange" />
    </view>
    <view class="de-field">
      <view class="field-label">备注</view>
      <textarea maxlength="500" class="field-textarea {{focusKey === 'remark' ? 'is-focus' : ''}}" value="{{remark}}" placeholder="烹饪小贴士、注意事项…" placeholder-class="placeholder" data-key="remark" bindfocus="onFocus" bindblur="onBlur" bindinput="onRemark" auto-height />
    </view>
  </view>
</view>

<view wx:if="{{!loading && !error && !recovery}}" class="de-save">
  <button class="btn btn-primary btn-lg btn-block" disabled="{{!name || saving || uploadingCover || uploadingExtra || videoImportBusy}}" hover-class="tap-active" bindtap="save">
    <view wx:if="{{saving}}" class="spinner"></view>
    <block wx:else><icon name="check" size="30" stroke="2.6" color="white" /><text>{{uploadingCover || uploadingExtra ? '图片上传中…' : isNew ? '创建私房菜' : '保存修改'}}</text></block>
  </button>
</view>
